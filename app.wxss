/* ===== Phase 2 字号工具类（与 --fs-* 令牌一一对应） ===== */
.fs-page-title { font-size: var(--fs-page-title); font-weight: 800; color: var(--cat-text); line-height: 1.3; }
.fs-section    { font-size: var(--fs-section);    font-weight: 700; color: var(--cat-text); line-height: 1.4; }
.fs-card-title { font-size: var(--fs-card-title); font-weight: 700; color: var(--cat-text); line-height: 1.4; }
.fs-body       { font-size: var(--fs-body);       font-weight: 400; color: var(--cat-text); line-height: 1.6; }
.fs-caption    { font-size: var(--fs-caption);    font-weight: 400; color: var(--cat-text-sub); line-height: 1.5; }
.fs-btn        { font-size: var(--fs-btn);        font-weight: 700; }
.fs-num        { font-size: var(--fs-num);        font-weight: 800; color: var(--cat-text); line-height: 1.1; }
.fs-num-lg     { font-size: var(--fs-num-lg);     font-weight: 800; color: var(--cat-text); line-height: 1.1; }
