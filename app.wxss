/* app.wxss - 全局主题层（卡通猫咪健身风格 · Phase 1） */
/* ================================================================
   设计令牌（Design Tokens）· 全站统一
   ----------------------------------------------------------------
   主绿 green       #66CDAA   深绿 green-deep  #3FAE85   亮绿 green-bright #4CD964
   辅助橙 orange    #FFB54D   橙渐变  #FFC566 → #FF9F1C（训练/猫咪强调）
   辅助蓝 blue      #4D9EFF   浅蓝 blue-bg     #E8F7FF（饮水区域）
   浅黄 yellow      #FFD166   浅粉 pink-bg     #FFE6F2（提示卡）
   页面背景 bg      #F8FBFA   卡片描边 outline rgba(31,74,58,0.08)
   柔和阴影 shadow  0 8rpx 24rpx rgba(31,74,58,0.06)
   文字层级        主 #333 / 正文 #666 / 辅助 #999 / 弱 #BBB
   圆角            卡片 32rpx · 按钮 48rpx（胶囊）· 标签 12rpx
   ================================================================ */

page {
  /* ===== CSS 设计令牌（全局变量 · 单一来源） ===== */
  --cat-green: #66cdaa;
  --cat-green-deep: #3fae85;
  --cat-green-bright: #4cd964;
  --cat-green-soft: #eafbf4;
  --cat-orange: #ffb54d;
  --cat-orange-deep: #ff9f1c;
  --cat-orange-soft: #fff3d6;
  --cat-blue: #4d9eff;
  --cat-blue-soft: #e8f7ff;
  --cat-yellow: #ffd166;
  --cat-pink: #ffe6f2;
  --cat-red: #ff6b6b;
  --cat-red-soft: #ffecec;
  --cat-bg: #f7f8fa;
  --cat-text: #222222;          /* Phase 2 正文 */
  --cat-text-sub: #888888;      /* Phase 2 辅助文字 */
  --cat-text-muted: #999999;
  --cat-text-weak: #bbbbbb;
  --cat-outline: rgba(31, 74, 58, 0.08);
  --cat-border: #eeeeee;        /* Phase 2 统一边框 */

  /* ===== Phase 2 语义色令牌（单一来源） ===== */
  --cat-primary: #ffb54d;             /* 主色：活力橙 */
  --cat-primary-deep: #ff9f1c;        /* 主色深 */
  --cat-primary-soft: #fff3d6;        /* 主色浅底 */
  --cat-success: #4cd964;             /* 成功/健康绿（喝一杯/已完成） */
  --cat-success-deep: #3fae85;
  --cat-success-soft: #eafbf4;
  --cat-warning: #ff6b6b;             /* 警示/删除红 */
  --cat-warning-soft: #ffecec;
  --cat-radius-sm: 12rpx;
  --cat-radius-md: 24rpx;
  --cat-radius-lg: 32rpx;
  --cat-radius-pill: 999rpx;
  --cat-shadow-sm: 0 2rpx 8rpx rgba(31, 74, 58, 0.04);
  --cat-shadow-md: 0 8rpx 24rpx rgba(31, 74, 58, 0.06);
  --cat-shadow-lg: 0 12rpx 32rpx rgba(102, 205, 170, 0.28);

  /* ===== Phase 2 设计系统：间距令牌（8/12/16/20/24/32/40 rpx） ===== */
  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 16rpx;
  --space-lg: 20rpx;
  --space-xl: 24rpx;
  --space-2xl: 32rpx;
  --space-3xl: 40rpx;

  /* ===== Phase 2 设计系统：字号令牌 ===== */
  --fs-page-title: 44rpx;   /* 页面大标题 */
  --fs-section: 32rpx;      /* 区块 / Section 标题 */
  --fs-card-title: 32rpx;   /* 卡片标题 */
  --fs-body: 28rpx;         /* 正文 */
  --fs-caption: 24rpx;      /* 辅助文字 */
  --fs-btn: 30rpx;          /* 按钮文字 */
  --fs-num: 48rpx;          /* 统计数字 */
  --fs-num-lg: 64rpx;       /* 英雄数字 */

  /* Phase 2：页面背景统一浅灰白 #F7F8FA，正文 #222222（覆盖旧值） */
  background-color: #f7f8fa;
  color: #222222;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue',
    'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

/* 全局盒模型重置：避免 padding/border 撑破宽度 */
view,
text,
image,
button,
input,
textarea,
scroll-view,
swiper,
canvas,
navigator {
  box-sizing: border-box;
}

/* 通用页面容器 */
.page-container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 40rpx;
}

/* 页面名称标题 */
.page-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #333333;
}

/* ===== 通用卡片：白底 + 32rpx 大圆角 + 漫画描边 + 柔和阴影 ===== */
.card {
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid rgba(31, 74, 58, 0.08); /* 卡通描边 */
  box-shadow: 0 8rpx 24rpx rgba(31, 74, 58, 0.06),
    0 2rpx 6rpx rgba(31, 74, 58, 0.04);
}

/* 卡片标题 */
.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 20rpx;
}

/* 卡片标题行（卡通图标 + 文本） */
.card-title-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.card-title-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.card-title-row .card-title {
  margin-bottom: 0;
}

/* 区块标题（猫爪小标由页面 WXML 提供，此处定义字号字重） */
.section-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 20rpx;
}

/* ===== 主按钮：活力橙渐变 + 胶囊圆角（Phase 2 primary） ===== */
.btn-primary {
  background-image: linear-gradient(135deg, #ffc566 0%, #ffb54d 50%, #ff9f1c 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 20rpx 0;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(255, 159, 28, 0.35);
}

.btn-primary:active {
  transform: translateY(2rpx) scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(255, 159, 28, 0.28);
}

/* ===== 成功按钮：健康绿渐变（喝一杯 / 已完成类正向操作） ===== */
.btn-success {
  background-image: linear-gradient(135deg, #7bdcb8 0%, #66cdaa 50%, #4cd964 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 20rpx 0;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(76, 217, 100, 0.32);
}

.btn-success:active {
  transform: translateY(2rpx) scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(76, 217, 100, 0.26);
}

/* ===== 警示按钮：红色（删除等破坏性操作） ===== */
.btn-warning {
  background-color: #ff6b6b;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 20rpx 0;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 107, 0.3);
}

.btn-warning:active {
  transform: translateY(2rpx) scale(0.98);
  background-color: #f25555;
}

/* ===== 次按钮：中性灰描边（次要操作） ===== */
.btn-secondary {
  background-color: #ffffff;
  color: #666666;
  font-size: 30rpx;
  border: 2rpx solid #dddddd;
  border-radius: 999rpx;
  padding: 18rpx 0;
  text-align: center;
  font-weight: 600;
}

.btn-secondary:active {
  background-color: #f5f5f7;
}

/* ===== 进度条：两端半圆 + 健康绿渐变 ===== */
.progress-wrap {
  height: 18rpx;
  background-color: #edf4f1;
  border-radius: 9rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background-image: linear-gradient(90deg, #66cdaa 0%, #4cd964 100%);
  border-radius: 9rpx;
  transition: width 0.3s ease;
}

/* ===== 通用小标签 ===== */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

/* 绿色标签（完成/成功） */
.tag-green {
  color: #3fae85;
  background-color: #e6f9ee;
  font-weight: 600;
}

/* 灰色标签（次要信息） */
.tag-gray {
  color: #666666;
  background-color: #f2f5f4;
}

/* ===== 强调数字颜色工具类 ===== */
.text-green {
  color: #3fae85;
}

.text-orange {
  color: #ff9f1c;
}

.text-blue {
  color: #4d9eff;
}

/* 大数字（重点数据） */
.num-lg {
  font-size: 56rpx;
  font-weight: 800;
  color: #333333;
}

/* ===== 卡通描边工具类 ===== */
.cat-outline {
  border: 2rpx solid rgba(31, 74, 58, 0.08);
}

/* ===== 安全区工具类 ===== */
.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* ================================================================
   Phase 1 主题增强：按钮状态 / 难度徽章 / 布局与排版工具类
   （纯新增，不改动任何已有类名与色值）
   ================================================================ */

/* ===== 按钮：禁用态（保存/提交中使用） ===== */
.btn-primary.disabled,
.btn-primary[disabled],
.btn-success.disabled,
.btn-success[disabled],
.btn-warning.disabled,
.btn-warning[disabled],
.btn-outline.disabled,
.btn-outline[disabled],
.btn-secondary.disabled,
.btn-secondary[disabled] {
  opacity: 0.55;
  pointer-events: none;
  box-shadow: none;
}

/* 通栏按钮（占满父容器宽度） */
.btn-block {
  display: block;
  width: 100%;
}

/* 按钮组：横向等宽双按钮 */
.btn-row {
  display: flex;
}
.btn-row .btn-primary,
.btn-row .btn-outline,
.btn-row .btn-secondary {
  flex: 1;
}
.btn-row view + view {
  margin-left: 20rpx;
}

/* ===== 难度徽章（动作库：易/中/难） ===== */
.tag-easy {
  color: #3fae85;
  background-color: #e6f9ee;
  font-weight: 600;
}
.tag-medium {
  color: #ff9f1c;
  background-color: #fff3d6;
  font-weight: 600;
}
.tag-hard {
  color: #ff6b6b;
  background-color: #ffecec;
  font-weight: 600;
}
.tag-blue {
  color: #4d9eff;
  background-color: #e8f7ff;
  font-weight: 600;
}
.tag-yellow {
  color: #b8860b;
  background-color: #fff6d6;
  font-weight: 600;
}

/* ===== 卡片按压反馈（可点击卡片统一触感） ===== */
.card-tap {
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}
.card-tap:active {
  transform: scale(0.985);
  box-shadow: var(--cat-shadow-sm);
}

/* ===== 布局工具类 ===== */
.flex {
  display: flex;
}
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}
.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.flex-1 {
  flex: 1;
}
.text-center {
  text-align: center;
}
.text-right {
  text-align: right;
}
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 字体层级工具类（与设计规范字号对齐） ===== */
.fs-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
}
.fs-card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}
.fs-body {
  font-size: 28rpx;
  color: #333333;
}
.fs-caption {
  font-size: 24rpx;
  color: #999999;
}
.fs-hint {
  font-size: 22rpx;
  color: #bbbbbb;
}

/* ===== 阴影 / 圆角工具类 ===== */
.shadow-sm {
  box-shadow: var(--cat-shadow-sm);
}
.shadow-md {
  box-shadow: var(--cat-shadow-md);
}
.radius-md {
  border-radius: var(--cat-radius-md);
}
.radius-lg {
  border-radius: var(--cat-radius-lg);
}

/* ===== 分隔线 ===== */
.divider {
  height: 1rpx;
  background-color: #f0f2f1;
  margin: 16rpx 0;
}

/* ================================================================
   Phase 1 增补：全局 UI 原语（纯新增，不改动任何已有类名与色值）
   供训练页/动作库/饮水/我的等页面统一引用，保证视觉语言一致。
   ================================================================ */

/* ===== 周计划圆形日期选择器（训练页） =====
   结构：.week-dots > .week-dot(.today/.done/.rest) > .week-dot-day + .week-dot-mark */
.week-dots {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 4rpx 4rpx;
}

.week-dot {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 6rpx;
}

.week-dot-circle {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: #ffffff;
  border: 2rpx solid rgba(31, 74, 58, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #666666;
  box-shadow: 0 2rpx 8rpx rgba(31, 74, 58, 0.05);
  transition: transform 0.12s ease;
}

.week-dot:active .week-dot-circle {
  transform: scale(0.94);
}

/* 今天：主绿实心高亮 */
.week-dot.today .week-dot-circle {
  background-image: linear-gradient(135deg, #7bdcb8 0%, #66cdaa 50%, #4cd964 100%);
  border-color: transparent;
  color: #ffffff;
  font-weight: 800;
  box-shadow: 0 6rpx 16rpx rgba(102, 205, 170, 0.38);
}

/* 已完成：浅绿底 + 深绿勾 */
.week-dot.done .week-dot-circle {
  background-color: #eafbf4;
  border-color: #66cdaa;
  color: #3fae85;
}

/* 休息日：灰色 */
.week-dot.rest .week-dot-circle {
  background-color: #f5f5f7;
  border-color: #e6e6e8;
  color: #bbbbbb;
}

.week-dot-day {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999999;
}

.week-dot.today .week-dot-day {
  color: #3fae85;
  font-weight: 700;
}

/* ===== 状态切换按钮组（未完成 / 已完成，训练页动作卡片） =====
   两态均可点击；active 为当前选中态，统一使用主绿品牌色 */
.state-toggle {
  display: flex;
  margin-top: 16rpx;
}

.state-btn {
  flex: none;
  min-width: 200rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 36rpx;
  padding: 12rpx 0;
  margin-right: 20rpx;
  background-color: #ffffff;
  border: 2rpx solid #dddddd;
  color: #999999;
  transition: transform 0.12s ease, background-color 0.12s ease;
}

.state-btn:last-child {
  margin-right: 0;
}

.state-btn:active {
  transform: scale(0.97);
}

/* 已完成选中：主绿实心白字 */
.state-btn.done.active {
  background-image: linear-gradient(135deg, #7bdcb8 0%, #66cdaa 50%, #4cd964 100%);
  border-color: transparent;
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(102, 205, 170, 0.32);
}

/* 未完成选中：描边绿色（白底深绿字，区别于实心完成态） */
.state-btn.undone.active {
  background-color: #ffffff;
  border-color: #66cdaa;
  color: #3fae85;
  box-shadow: 0 4rpx 12rpx rgba(102, 205, 170, 0.18);
}

/* ===== 完成庆祝：星星弹出（纯 CSS，不改完成逻辑） ===== */
.celebrate {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.celebrate-star {
  position: absolute;
  font-size: 28rpx;
  animation: star-pop 1.1s ease-out infinite;
  pointer-events: none;
}

.celebrate-star.s1 { left: -36rpx; top: -10rpx; animation-delay: 0s; }
.celebrate-star.s2 { right: -30rpx; top: -16rpx; animation-delay: 0.25s; }
.celebrate-star.s3 { left: 50%; top: -34rpx; animation-delay: 0.5s; font-size: 22rpx; }

@keyframes star-pop {
  0% {
    opacity: 0;
    transform: translateY(8rpx) scale(0.6);
  }
  40% {
    opacity: 1;
    transform: translateY(-6rpx) scale(1.1);
  }
  100% {
    opacity: 0;
    transform: translateY(-18rpx) scale(0.9);
  }
}

/* 完成提示条 */
.done-banner {
  display: flex;
  align-items: center;
  justify-content: center;
  background-image: linear-gradient(135deg, #eafbf4 0%, #d8f5e6 100%);
  border: 2rpx solid rgba(102, 205, 170, 0.4);
  color: #2e9e6a;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  margin-top: 16rpx;
}

/* ================================================================
   Phase 2 设计系统模块（统一卡通猫咪 UI Design System）
   ----------------------------------------------------------------
   本模块在已有原语基础上增补，集中管理：
   间距 / 字号 / 卡片增强 / 按钮补齐 / 进度条变体 / 表单输入 / 工具类
   所有新增类均以 --cat-* 令牌为单一颜色来源。
   ================================================================ */

/* ===== 间距体系（8 点栅格：8/12/16/20/24/32/40） ===== */
page {
  --space-1: 16rpx;   /* 8px  */
  --space-2: 24rpx;   /* 12px */
  --space-3: 32rpx;   /* 16px */
  --space-4: 40rpx;   /* 20px */
  --space-5: 48rpx;   /* 24px */
  --space-6: 64rpx;   /* 32px */
  --space-7: 80rpx;   /* 40px */
}

.p-1 { padding: var(--space-1); }
.p-2 { padding: var(--space-2); }
.p-3 { padding: var(--space-3); }
.p-4 { padding: var(--space-4); }
.p-5 { padding: var(--space-5); }
.p-6 { padding: var(--space-6); }
.p-7 { padding: var(--space-7); }

.mt-1 { margin-top: var(--space-1); }
.mt-2 { margin-top: var(--space-2); }
.mt-3 { margin-top: var(--space-3); }
.mt-4 { margin-top: var(--space-4); }
.mt-5 { margin-top: var(--space-5); }
.mt-6 { margin-top: var(--space-6); }
.mt-7 { margin-top: var(--space-7); }
.mb-1 { margin-bottom: var(--space-1); }
.mb-2 { margin-bottom: var(--space-2); }
.mb-3 { margin-bottom: var(--space-3); }
.mb-4 { margin-bottom: var(--space-4); }
.mb-5 { margin-bottom: var(--space-5); }
.mb-6 { margin-bottom: var(--space-6); }
.mb-7 { margin-bottom: var(--space-7); }

/* ===== 字号体系（语义化层级） ===== */
.text-page-title { font-size: 44rpx; font-weight: 800; color: var(--cat-text); line-height: 1.3; }
.text-section     { font-size: 32rpx; font-weight: 700; color: var(--cat-text); line-height: 1.4; }
.text-card-title  { font-size: 32rpx; font-weight: 700; color: var(--cat-text); line-height: 1.4; }
.text-body        { font-size: 28rpx; font-weight: 400; color: var(--cat-text); line-height: 1.6; }
.text-caption     { font-size: 24rpx; font-weight: 400; color: var(--cat-text-sub); line-height: 1.5; }
.text-btn         { font-size: 30rpx; font-weight: 700; }
.text-num-lg      { font-size: 64rpx; font-weight: 800; color: var(--cat-text); line-height: 1.1; }
.text-num         { font-size: 48rpx; font-weight: 800; color: var(--cat-text); line-height: 1.1; }
.text-num-md      { font-size: 36rpx; font-weight: 700; color: var(--cat-text); line-height: 1.2; }

/* ===== 次按钮：清新蓝描边（饮水/信息类，保留兼容） ===== */
.btn-outline {
  background-color: #ffffff;
  color: var(--cat-blue);
  font-size: 30rpx;
  border: 2rpx solid var(--cat-blue);
  border-radius: 999rpx;
  padding: 18rpx 0;
  text-align: center;
  font-weight: 600;
}
.btn-outline:active {
  background-color: #eef5ff;
}

/* ===== 进度条变体（训练进度用橙色，其他默认绿色） ===== */
.progress-wrap {
  height: 18rpx;
  background-color: #edf0f2;
  border-radius: 999rpx;
  overflow: hidden;
}
.progress-inner {
  height: 100%;
  background-image: linear-gradient(90deg, #66cdaa 0%, #4cd964 100%);
  border-radius: 999rpx;
  transition: width 0.3s ease;
}
/* 训练进度：橙色 */
.progress-inner.training {
  background-image: linear-gradient(90deg, #ffc566 0%, #ffb54d 50%, #ff9f1c 100%);
}
/* 粗进度条（首页/饮水大卡） */
.progress-wrap.thick {
  height: 22rpx;
}

/* ===== 表单输入：圆角卡通输入框 ===== */
.form-input,
.input {
  height: 80rpx;
  background-color: #f7f8fa;
  border: 2rpx solid var(--cat-border);
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--cat-text);
  box-sizing: border-box;
}
.form-input:focus,
.input:focus {
  border-color: var(--cat-primary);
  background-color: #ffffff;
}

/* ===== 卡片增强：标题行（左标题 + 右链接） ===== */
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-3);
}
.card-link {
  font-size: 24rpx;
  color: var(--cat-blue);
  font-weight: 600;
}

/* ===== 页面通用标题区（左标题 + 右猫咪） ===== */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-2) var(--space-1) var(--space-4);
}
.page-header-title {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--cat-text);
}

/* ===== 空状态（统一卡通空态） ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}
.empty-state-text {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--cat-text-sub);
  text-align: center;
}

