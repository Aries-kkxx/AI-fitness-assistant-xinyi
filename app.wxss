/* app.wxss - 全局样式 */
/* 这里只放所有页面共用的基础样式，避免在页面中重复书写 */

page {
  background-color: #f7f8fa;
  color: #333333;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue',
    'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

/* 通用页面容器：让页面内容垂直水平居中（Phase 1 用于显示页面名称） */
.page-container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 40rpx;
}

/* 页面名称标题 */
.page-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #333333;
}

/* ===== 以下为 Phase 5 新增的通用组件样式 ===== */

/* 通用卡片 */
.card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 卡片标题 */
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
}

/* 主按钮（绿色） */
.btn-primary {
  background-color: #07c160;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 44rpx;
  padding: 20rpx 0;
  text-align: center;
}

.btn-primary:active {
  background-color: #06ad56;
}

/* 次按钮（浅色描边） */
.btn-outline {
  background-color: #ffffff;
  color: #07c160;
  font-size: 30rpx;
  border: 2rpx solid #07c160;
  border-radius: 44rpx;
  padding: 18rpx 0;
  text-align: center;
}

.btn-outline:active {
  background-color: #f0faf5;
}

/* 进度条 */
.progress-wrap {
  height: 16rpx;
  background-color: #ececec;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background-color: #07c160;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

/* 通用小标签 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

/* 绿色标签（强调） */
.tag-green {
  color: #07c160;
  background-color: #f0faf5;
}

/* 灰色标签（次要信息） */
.tag-gray {
  color: #666666;
  background-color: #f5f5f5;
}
