<!-- components/cat-mascot/cat-mascot.wxml - 纯 CSS 卡通橘白猫 -->
<view class="ct-root" style="width: {{size}}rpx; height: {{size}}rpx; transform: scale({{scale}});">
  <view class="ct-inner {{animate}}">

    <!-- 尾巴 -->
    <view class="ct-tail"></view>

    <!-- 身体 -->
    <view class="ct-body">
      <view class="ct-belly"></view>
      <!-- 抱水杯（drink） -->
      <view class="ct-cup" wx:if="{{pose === 'drink'}}">
        <view class="ct-cup-rim"></view>
        <view class="ct-cup-water"></view>
      </view>
    </view>

    <!-- 前爪（wave 时右爪抬起摆动） -->
    <view class="ct-paw left"></view>
    <view class="ct-paw right {{pose === 'wave' ? 'wave' : ''}}"></view>

    <!-- 头 -->
    <view class="ct-head">
      <!-- 耳朵（容器旋转，内耳跟随） -->
      <view class="ct-ear left">
        <view class="ct-ear-shape"></view>
        <view class="ct-ear-in"></view>
      </view>
      <view class="ct-ear right">
        <view class="ct-ear-shape"></view>
        <view class="ct-ear-in"></view>
      </view>
      <!-- 头顶橘色斑 -->
      <view class="ct-cap"></view>
      <!-- 眼睛（醒着） -->
      <block wx:if="{{pose !== 'sleep'}}">
        <view class="ct-eye left"><view class="ct-gleam"></view></view>
        <view class="ct-eye right"><view class="ct-gleam"></view></view>
      </block>
      <!-- 闭眼（睡觉） -->
      <block wx:else>
        <view class="ct-sleep-eye left"></view>
        <view class="ct-sleep-eye right"></view>
      </block>
      <!-- 腮红 / 鼻子 / 嘴 -->
      <view class="ct-cheek left"></view>
      <view class="ct-cheek right"></view>
      <view class="ct-nose"></view>
      <view class="ct-mouth"></view>
    </view>

    <!-- 睡觉 Zzz -->
    <view class="ct-zzz" wx:if="{{pose === 'sleep'}}">z z z</view>
  </view>
</view>
