/* components/float-ball/float-ball.wxss - 「欣一」小猫悬浮球样式 */
/* 使用 position: fixed 绝对定位，无任何过渡动画 */

.float-ball {
  position: fixed;
  width: 96px;
  height: 116px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 999;
  background: transparent;
  transition: none;
  animation: none;
}

.float-ball-icon {
  width: 80px;
  height: 80px;
  display: block;
  border-radius: 16rpx;
}

.float-ball-name {
  margin-top: 4rpx;
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #333333;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  white-space: nowrap;
  line-height: 1.4;
  letter-spacing: 2rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}