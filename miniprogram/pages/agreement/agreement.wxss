/* pages/agreement/agreement.wxss - 协议/隐私政策页样式
   沿用 app.wxss 设计令牌（猫咪健身风：浅灰底 + 白色圆角卡片 + 健康绿/活力橙点缀） */
.agree-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background-color: var(--cat-bg, #f7f8fa);
}

/* 页头 */
.agree-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}
.agree-cat {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 8rpx;
}
.agree-title {
  font-size: var(--fs-page-title, 44rpx);
  font-weight: 800;
  color: var(--cat-text, #222222);
}
.agree-subtitle {
  margin-top: 8rpx;
  font-size: var(--fs-caption, 24rpx);
  color: var(--cat-text-muted, #999999);
}

/* 正文卡片 */
.agree-body {
  display: flex;
  flex-direction: column;
}
.section {
  background-color: #ffffff;
  border-radius: var(--cat-radius-lg, 32rpx);
  border: 2rpx solid var(--cat-outline, rgba(31, 74, 58, 0.08));
  box-shadow: var(--cat-shadow-sm, 0 2rpx 8rpx rgba(31, 74, 58, 0.04));
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}
.heading {
  display: flex;
  align-items: center;
  font-size: var(--fs-card-title, 32rpx);
  font-weight: 700;
  color: var(--cat-text, #222222);
  margin-bottom: 16rpx;
}
.heading::before {
  content: '';
  flex: none;
  width: 8rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #7bdcb8 0%, #66cdaa 50%, #4cd964 100%);
  margin-right: 14rpx;
}
.para {
  font-size: var(--fs-body, 28rpx);
  color: #555555;
  line-height: 1.7;
  margin-bottom: 12rpx;
}
.para:last-child {
  margin-bottom: 0;
}

/* 页脚 */
.agree-footer {
  margin-top: 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--cat-text-weak, #bbbbbb);
}
