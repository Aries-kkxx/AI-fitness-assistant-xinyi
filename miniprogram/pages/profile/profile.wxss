/* pages/profile/profile.wxss - 我的页样式（卡通漫画风格） */

.page {
  padding: 30rpx;
}

/* 用户信息卡片 */
.user-card {
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background-image: linear-gradient(135deg, #ffc566 0%, #ffb54d 60%, #ff9f1c 100%);
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(255, 181, 77, 0.35);
}

.user-info {
  flex: 1;
  margin-left: 24rpx;
}

.user-name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #333333;
}

.user-desc {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.edit-link {
  font-size: 26rpx;
  color: #ff9f1c;
  flex-shrink: 0;
  font-weight: 600;
}

/* 功能菜单 */
.menu-row {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f5f5f7;
}

.menu-row:last-child {
  border-bottom: none;
}

/* 取消圆圈背景限制：图标按原图比例自适应显示，不再被圆形 + 彩色底板 + 描边 + 阴影强行框住 */
.menu-icon-img {
  width: 64rpx;
  height: 64rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.menu-name {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
  font-weight: 600;
}

.menu-arrow {
  font-size: 32rpx;
  color: #cccccc;
}
