/* pages/recovery/recovery.wxss - 每日身体状态记录页 */

.page {
  min-height: 100vh;
  padding: calc(88rpx + env(safe-area-inset-top)) var(--space-xl) calc(var(--space-3xl) + env(safe-area-inset-bottom));
}

.sky-bg {
  background: linear-gradient(180deg, #E8F7FF 0%, #F7F8FA 30%, #F7F8FA 100%);
}

/* ===== 自定义导航栏 ===== */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: calc(88rpx + env(safe-area-inset-top));
  padding-top: env(safe-area-inset-top);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: var(--space-md);
  padding-right: var(--space-md);
  background-color: #E8F7FF;
  z-index: 100;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #222222;
  font-weight: 700;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #222222;
}

.nav-placeholder {
  width: 60rpx;
}

/* ===== 通用 ===== */
.card {
  background-color: #FFFFFF;
  border-radius: var(--cat-radius-lg);
  padding: var(--space-xl);
  margin-bottom: var(--space-xl);
  box-shadow: var(--cat-shadow-md);
}

.loading {
  text-align: center;
  padding: var(--space-3xl);
  color: #999999;
}

/* ===== 表单卡 ===== */
.form-card {
  margin-top: var(--space-xl);
}

.form-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-md);
}

.form-title-wrap {
  display: flex;
  flex-direction: column;
}

.form-title {
  font-size: var(--fs-card-title);
  font-weight: 800;
  color: #222222;
}

.form-sub {
  margin-top: var(--space-xs);
  font-size: 20rpx;
  color: #999999;
}

.back-today {
  height: 52rpx;
  padding: 0 var(--space-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #4D9EFF;
  background-color: #E8F4FF;
  border-radius: var(--cat-radius-pill);
  flex-shrink: 0;
}

/* ===== 评分项 ===== */
.score-item {
  padding: var(--space-sm) 0;
}

.score-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-xs);
}

.score-label {
  font-size: var(--fs-body);
  font-weight: 600;
  color: #333333;
}

.score-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #FF9F1C;
  background-color: #FFF9E8;
  padding: 2rpx 16rpx;
  border-radius: var(--cat-radius-pill);
}

.score-slider {
  margin: 0;
}

/* ===== 备注 ===== */
.note-row {
  margin-top: var(--space-md);
}

.note-input {
  width: 100%;
  min-height: 96rpx;
  padding: var(--space-sm) var(--space-md);
  box-sizing: border-box;
  font-size: 24rpx;
  color: #555555;
  background-color: #F8F9FA;
  border-radius: var(--cat-radius-md);
}

/* ===== 操作按钮 ===== */
.form-actions {
  display: flex;
  gap: var(--space-md);
  margin-top: var(--space-xl);
}

.save-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-btn);
  font-weight: 800;
  color: #FFFFFF;
  background: linear-gradient(135deg, #FFB54D 0%, #FF9F1C 100%);
  border-radius: var(--cat-radius-pill);
  box-shadow: 0 8rpx 20rpx rgba(255, 159, 28, 0.28);
}

.btn-delete {
  height: 80rpx;
  padding: 0 var(--space-2xl);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  font-weight: 600;
  color: #FF6B6B;
  background-color: #FFEDED;
  border: 2rpx solid rgba(255, 107, 107, 0.3);
  border-radius: var(--cat-radius-pill);
  flex-shrink: 0;
}

/* ===== 历史 ===== */
.history-card {
  padding: var(--space-xl) var(--space-lg);
}

.his-empty {
  padding: var(--space-2xl) 0;
  text-align: center;
  font-size: var(--fs-caption);
  color: #999999;
}

.his-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-md) var(--space-sm);
  border-bottom: 1rpx solid #F5F5F5;
}

.his-item:last-child {
  border-bottom: none;
}

.his-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}

.his-date {
  font-size: var(--fs-body);
  font-weight: 700;
  color: #222222;
}

.his-summary {
  margin-top: var(--space-xs);
  font-size: 22rpx;
  color: #666666;
}

.his-body {
  margin-top: var(--space-xs);
  font-size: 22rpx;
  color: #FF9F1C;
  font-weight: 600;
}

.his-note {
  margin-top: var(--space-xs);
  font-size: 20rpx;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 460rpx;
}

.his-del {
  height: 52rpx;
  padding: 0 var(--space-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #FF6B6B;
  background-color: #FFEDED;
  border-radius: var(--cat-radius-pill);
  flex-shrink: 0;
  margin-left: var(--space-md);
}
