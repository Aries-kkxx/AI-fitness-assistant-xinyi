/* pages/stats/stats.wxss - 个人健身成长档案 */

.page {
  min-height: 100vh;
  padding: calc(88rpx + env(safe-area-inset-top)) var(--space-xl) calc(var(--space-3xl) + env(safe-area-inset-bottom));
}

.sky-bg {
  background: linear-gradient(180deg, #E8F7FF 0%, #F7F8FA 30%, #F7F8FA 100%);
}

/* ===== 自定义导航栏 ===== */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: calc(88rpx + env(safe-area-inset-top));
  padding-top: env(safe-area-inset-top);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: var(--space-md);
  padding-right: var(--space-md);
  background-color: #E8F7FF;
  z-index: 100;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #222222;
  font-weight: 700;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #222222;
}

.nav-placeholder {
  width: 60rpx;
}

/* ===== 通用 ===== */
.card {
  background-color: #FFFFFF;
  border-radius: var(--cat-radius-lg);
  padding: var(--space-xl);
  margin-bottom: var(--space-xl);
  box-shadow: var(--cat-shadow-md);
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-md);
}

.card-title {
  font-size: var(--fs-card-title);
  font-weight: 800;
  color: #222222;
}

.card-link {
  font-size: 22rpx;
  color: #4D9EFF;
  font-weight: 600;
}

.loading {
  text-align: center;
  padding: var(--space-3xl);
  color: #999999;
}

/* ===== 统计 ===== */
.stat-row {
  display: flex;
  margin-bottom: var(--space-sm);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #222222;
}

.stat-num.green {
  color: #2E9E63;
}

.stat-num.orange {
  color: #FF9F1C;
}

.stat-num.small {
  font-size: 30rpx;
}

.stat-label {
  margin-top: var(--space-xs);
  font-size: 20rpx;
  color: #999999;
}

.stat-tip {
  margin-top: var(--space-sm);
  font-size: 20rpx;
  color: #BBBBBB;
}

.stat-tip.center {
  text-align: center;
  margin-top: var(--space-md);
}

/* ===== 体重 ===== */
.weight-hero {
  display: flex;
  align-items: baseline;
  padding: var(--space-sm) 0;
}

.weight-num {
  font-size: 64rpx;
  font-weight: 800;
  color: #222222;
}

.weight-unit {
  font-size: 26rpx;
  color: #999999;
  margin-left: var(--space-xs);
}

.weight-deltas {
  display: flex;
  flex-direction: column;
  margin-left: var(--space-xl);
}

.weight-delta {
  font-size: 22rpx;
  color: #666666;
  margin-bottom: var(--space-xs);
}

/* ===== 趋势图 ===== */
.trend-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
}

.trend-tab {
  height: 52rpx;
  padding: 0 var(--space-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #888888;
  background-color: #F2F2F2;
  border-radius: var(--cat-radius-pill);
}

.trend-tab.active {
  color: #FFFFFF;
  background: linear-gradient(135deg, #66CDAA 0%, #4CD964 100%);
}

.chart-canvas {
  width: 100%;
  height: 300rpx;
}

/* ===== AI 分析 ===== */
.ai-card {
  background: linear-gradient(135deg, #F0F4FF 0%, #E6EEFF 100%);
  border: 2rpx solid rgba(77, 158, 255, 0.25);
}

.ai-desc {
  font-size: 22rpx;
  color: #5B7FD9;
  line-height: 1.6;
  margin-bottom: var(--space-md);
}

.ai-btn {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: linear-gradient(135deg, #4D9EFF 0%, #3D8BFF 100%);
  border-radius: var(--cat-radius-pill);
}

.ai-btn.disabled {
  opacity: 0.5;
}

.ai-result {
  margin-top: var(--space-md);
  padding: var(--space-md);
  font-size: 24rpx;
  color: #333333;
  line-height: 1.7;
  background-color: #FFFFFF;
  border-radius: var(--cat-radius-md);
  white-space: pre-wrap;
}

/* ===== 成就 ===== */
.ach-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}

.ach-item {
  width: calc(33.33% - var(--space-sm) * 2 / 3);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-md) var(--space-xs);
  background-color: #F8F9FA;
  border-radius: var(--cat-radius-md);
  box-sizing: border-box;
}

.ach-item.unlocked {
  background: linear-gradient(135deg, #FFF9E8 0%, #FFF3D6 100%);
  border: 2rpx solid rgba(255, 209, 102, 0.4);
}

.ach-icon {
  font-size: 40rpx;
  margin-bottom: var(--space-xs);
}

.ach-title {
  font-size: 20rpx;
  font-weight: 700;
  color: #888888;
  text-align: center;
}

.ach-item.unlocked .ach-title {
  color: #B8860B;
}

.ach-progress {
  width: 80%;
  height: 8rpx;
  margin-top: var(--space-sm);
  background-color: #EEEEEE;
  border-radius: var(--cat-radius-pill);
  overflow: hidden;
}

.ach-progress-inner {
  height: 100%;
  background: linear-gradient(90deg, #FFB54D 0%, #FF9F1C 100%);
  border-radius: var(--cat-radius-pill);
}

.ach-date {
  margin-top: var(--space-xs);
  font-size: 24rpx;
  color: #2E9E63;
  font-weight: 800;
}

/* ===== 数据管理 ===== */
.data-row {
  display: flex;
  align-items: center;
  padding: var(--space-md) 0;
}

.data-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #222222;
}

.data-sub {
  flex: 1;
  margin-left: var(--space-md);
  font-size: 20rpx;
  color: #999999;
}

.data-arrow {
  font-size: 30rpx;
  color: #BBBBBB;
}

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
}

