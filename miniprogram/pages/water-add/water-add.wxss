/* pages/water-add/water-add.wxss - 手动添加饮水记录页样式 */

.page {
  padding: 30rpx 30rpx 200rpx; /* 底部预留固定保存栏空间 */
}

/* 表单一行：左侧标签 + 右侧输入/选择 */
.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 30rpx;
  color: #333333;
  flex-shrink: 0;
}

/* picker 展示值 */
.form-value {
  font-size: 30rpx;
  color: #ff9f1c;
  font-weight: 600;
}

/* 文本输入框 */
.form-input {
  font-size: 30rpx;
  color: #333333;
  text-align: right;
  width: 380rpx;
}

/* 固定底部保存栏（滚动不跟随） */
.save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ffffff;
  padding: 16rpx 30rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.save-btn {
  margin-top: 0;
}
