<!-- pages/water-setting/water-setting.wxml - 饮水设置页 -->
<view class="page">
  <!-- 设置卡片 -->
  <view class="card">
    <view class="card-title-row">
      <image class="card-title-icon" src="/assets/pets/羊.png" mode="aspectFill" />
      <text class="card-title">饮水设置</text>
    </view>

    <!-- 每天杯数 -->
    <view class="setting-row">
      <text class="setting-label">每天喝几杯</text>
      <view class="stepper">
        <view class="stepper-btn" bindtap="onCupsMinus">−</view>
        <text class="stepper-num">{{dailyCups}}</text>
        <view class="stepper-btn" bindtap="onCupsPlus">＋</view>
      </view>
    </view>

    <!-- 每杯容量 -->
    <view class="setting-row">
      <text class="setting-label">每杯容量 (ml)</text>
      <view class="stepper">
        <view class="stepper-btn" bindtap="onMlMinus">−</view>
        <text class="stepper-num">{{cupMl}}</text>
        <view class="stepper-btn" bindtap="onMlPlus">＋</view>
      </view>
    </view>
  </view>

  <!-- 自动计算结果 -->
  <view class="card target-card">
    <text class="target-label">每日目标水量</text>
    <text class="target-value">{{dailyCups}} 杯 × {{cupMl}}ml = {{dailyTargetMl}}ml/天</text>
  </view>

  <!-- 保存按钮（固定底部） -->
  <view class="save-bar">
    <view class="btn-primary save-btn" bindtap="onSave">保存设置</view>
  </view>
</view>

