/* pages/water-setting/water-setting.wxss - 饮水设置页样式 */

.page {
  padding: 30rpx 30rpx 200rpx; /* 底部预留固定保存栏空间 */
}

/* 设置项一行：左侧文字 + 右侧步进器 */
.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.setting-row:last-child {
  border-bottom: none;
}

.setting-label {
  font-size: 30rpx;
  color: #333333;
}

/* 步进器：减号 / 数值 / 加号 */
.stepper {
  display: flex;
  align-items: center;
}

.stepper-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: #fff3d6;
  color: #ff9f1c;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stepper-btn:active {
  background-color: #ffe3b3;
}

.stepper-num {
  min-width: 100rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #333333;
}

/* 目标水量展示卡片 */
.target-card {
  text-align: center;
}

.target-label {
  display: block;
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 12rpx;
}

.target-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #ff9f1c;
}

/* 固定底部保存栏（滚动不跟随） */
.save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ffffff;
  padding: 16rpx 30rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.save-btn {
  margin-top: 0;
}
