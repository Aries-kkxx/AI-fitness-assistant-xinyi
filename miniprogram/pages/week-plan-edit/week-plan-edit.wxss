/* pages/week-plan-edit/week-plan-edit.wxss - 自定义周计划编辑页样式 */

.page {
  padding: 30rpx 30rpx 200rpx; /* 底部预留固定保存栏空间 */
}

.loading {
  text-align: center;
  color: #999999;
  padding: 100rpx 0;
}

/* 周几 Tab */
.day-tabs {
  display: flex;
  margin-bottom: 24rpx;
}

.day-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #666666;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx 0;
  margin-right: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.day-tab:last-child {
  margin-right: 0;
}

.day-tab.active {
  color: #ffffff;
  background-image: linear-gradient(135deg, #ffc566 0%, #ffb54d 60%, #ff9f1c 100%);
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(255, 181, 77, 0.3);
}

.day-tab.rest {
  color: #bbbbbb;
}

.day-count {
  display: block;
  font-size: 20rpx;
  margin-top: 4rpx;
  opacity: 0.8;
}

/* 编辑卡片 */
.edit-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.edit-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.edit-tools {
  display: flex;
  align-items: center;
}

/* 清空所有 */
.clear-all {
  font-size: 24rpx;
  color: #ff6b6b;
  background-color: #ffecec;
  border: 2rpx solid #ffc4c4;
  border-radius: 28rpx;
  padding: 6rpx 20rpx;
  margin-right: 20rpx;
}

.clear-all:active {
  background-color: #ffdada;
}

.rest-switch {
  display: flex;
  align-items: center;
}

.rest-label {
  font-size: 24rpx;
  color: #999999;
  margin-right: 8rpx;
}

.rest-tip {
  text-align: center;
  color: #999999;
  font-size: 26rpx;
  padding: 60rpx 0;
}

/* 已选摘要 */
.selected-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.selected-text {
  font-size: 26rpx;
  color: #ff9f1c;
  font-weight: 700;
}

.selected-clear {
  font-size: 24rpx;
  color: #ff6b6b;
}

/* 分类筛选 */
.cats {
  white-space: nowrap;
  margin-bottom: 10rpx;
}

.cat {
  display: inline-block;
  font-size: 24rpx;
  color: #666666;
  background-color: #f5f5f7;
  border-radius: 28rpx;
  padding: 8rpx 24rpx;
  margin-right: 12rpx;
}

.cat.active {
  color: #ffffff;
  background-image: linear-gradient(135deg, #ffc566 0%, #ffb54d 60%, #ff9f1c 100%);
  font-weight: 700;
}

/* 动作勾选行 */
.ex-check {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.ex-check:last-child {
  border-bottom: none;
}

.ex-check-info {
  flex: 1;
}

.ex-check-name {
  display: block;
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.ex-check-tags {
  display: flex;
  flex-wrap: wrap;
}

/* 勾选框 */
.check-box {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #dddddd;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #ffffff;
  flex-shrink: 0;
}

.check-box.checked {
  background-color: #4cd964;
  border-color: #4cd964;
}

.empty {
  text-align: center;
  color: #999999;
  font-size: 26rpx;
  padding: 40rpx 0;
}

/* 初始来源提示 */
.plan-source-tip {
  font-size: 22rpx;
  color: #ff9f1c;
  background-color: #fff3d6;
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
  margin-bottom: 20rpx;
}

/* 固定底部保存栏（滚动不跟随） */
.save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ffffff;
  padding: 16rpx 30rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.save-btn {
  margin-top: 0;
}

.save-btn.disabled {
  background-color: #f0c98f;
}
