/* pages/weight/weight.wxss - 体重记录页样式 */

.page {
  padding: 30rpx 30rpx 200rpx; /* 底部预留固定保存栏空间 */
}

/* 当前体重 */
.current-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 24rpx;
}

.current-num {
  font-size: 72rpx;
  font-weight: 700;
  color: #333333;
}

.current-unit {
  font-size: 28rpx;
  color: #999999;
  margin-left: 8rpx;
}

.delta-tag {
  margin-left: 24rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #2e9e5b;
  background-color: #e6f9ee;
  border-radius: 14rpx;
  padding: 8rpx 16rpx;
}

.delta-sub {
  font-size: 22rpx;
  font-weight: 400;
  color: #999999;
  margin-left: 4rpx;
}

/* 输入行 */
.input-row {
  display: flex;
  align-items: center;
}

.weight-input {
  flex: 1;
  height: 76rpx;
  background-color: #f5f5f5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
}

/* 固定底部保存栏（滚动不跟随） */
.save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ffffff;
  padding: 16rpx 30rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.save-btn {
  margin-top: 0;
}

.save-btn.disabled {
  background-color: #f0c98f;
}

/* 曲线 */
.chart-wrap {
  width: 100%;
  height: 360rpx;
}

.chart-canvas {
  width: 100%;
  height: 360rpx;
}

/* 历史记录 */
.record-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.record-row:last-child {
  border-bottom: none;
}

.record-date {
  flex: 1;
  font-size: 28rpx;
  color: #666666;
}

.record-weight {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-right: 24rpx;
}

.record-del {
  font-size: 26rpx;
  color: #ff6b6b;
  padding: 8rpx 16rpx;
}

.no-data {
  text-align: center;
  color: #999999;
  font-size: 26rpx;
  padding: 40rpx 0;
}
