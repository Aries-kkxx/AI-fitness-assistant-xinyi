/* pages/workout-detail/workout-detail.wxss - 训练记录编辑页（力量训练明细） */

.page {
  min-height: 100vh;
  padding: calc(88rpx + env(safe-area-inset-top)) var(--space-xl) calc(220rpx + env(safe-area-inset-bottom));
}

.sky-bg {
  background: linear-gradient(180deg, #E8F7FF 0%, #F7F8FA 30%, #F7F8FA 100%);
}

/* ===== 自定义导航栏 ===== */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: calc(88rpx + env(safe-area-inset-top));
  padding-top: env(safe-area-inset-top);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: var(--space-md);
  padding-right: var(--space-md);
  background-color: #E8F7FF;
  z-index: 100;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #222222;
  font-weight: 700;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #222222;
}

.nav-save {
  width: 160rpx;
  text-align: right;
  font-size: 20rpx;
  color: #66CDAA;
}

.nav-placeholder {
  width: 60rpx;
}

/* ===== 卡片通用 ===== */
.card {
  background-color: #FFFFFF;
  border-radius: var(--cat-radius-lg);
  padding: var(--space-xl);
  margin-bottom: var(--space-xl);
  box-shadow: var(--cat-shadow-md);
}

.loading {
  text-align: center;
  padding: var(--space-3xl);
  color: #999999;
}

/* ===== 引导卡 ===== */
.guide-card {
  text-align: center;
  margin-top: var(--space-2xl);
}

.guide-title {
  font-size: var(--fs-card-title);
  font-weight: 700;
  color: #222222;
  margin-bottom: var(--space-md);
}

.guide-desc {
  font-size: var(--fs-body);
  color: #888888;
  margin-bottom: var(--space-xl);
  line-height: 1.6;
}

.guide-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 var(--space-2xl);
  font-size: var(--fs-btn);
  font-weight: 700;
  color: #FFFFFF;
  background: linear-gradient(135deg, #FFB54D 0%, #FF9F1C 100%);
  border-radius: var(--cat-radius-pill);
  box-shadow: 0 8rpx 20rpx rgba(255, 159, 28, 0.28);
}

/* ===== 计时器卡 ===== */
.timer-card {
  margin-top: var(--space-xl);
  background: linear-gradient(135deg, #FFF9E8 0%, #FFF3D6 100%);
  border: 2rpx solid rgba(255, 209, 102, 0.3);
  text-align: center;
}

.timer-card.paused {
  background: linear-gradient(135deg, #F0F4FF 0%, #E6EEFF 100%);
  border-color: rgba(77, 158, 255, 0.3);
}

.timer-card.ended {
  background: linear-gradient(135deg, #EAFBF4 0%, #D8F5E7 100%);
  border-color: rgba(102, 205, 170, 0.35);
}

.timer-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-md);
}

.timer-label {
  font-size: var(--fs-caption);
  color: #999999;
}

.timer-status {
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 20rpx;
  border-radius: var(--cat-radius-pill);
}

.timer-status.running {
  color: #FF9F1C;
  background-color: #FFF3D6;
}

.timer-status.paused {
  color: #4D9EFF;
  background-color: #E6EEFF;
}

.timer-status.done {
  color: #1F6B4C;
  background-color: #D8F5E7;
}

.timer-status.idle {
  color: #999999;
  background-color: #F2F2F2;
}

.timer-text {
  display: block;
  font-size: 88rpx;
  font-weight: 800;
  color: #222222;
  font-variant-numeric: tabular-nums;
  margin-bottom: var(--space-lg);
}

.timer-btns {
  display: flex;
  justify-content: center;
  gap: var(--space-md);
}

.timer-start {
  height: 76rpx;
  padding: 0 var(--space-3xl);
}

.timer-btn {
  min-width: 180rpx;
  height: 76rpx;
}

/* ===== 草稿恢复提示 ===== */
.draft-tip {
  font-size: 22rpx;
  color: #4C9C78;
  text-align: center;
  margin: calc(-1 * var(--space-sm)) 0 var(--space-md);
}

/* ===== 完成进度 ===== */
.progress-row {
  display: flex;
  align-items: center;
  margin-bottom: var(--space-xl);
}

.progress-text {
  font-size: var(--fs-caption);
  color: #888888;
  margin-right: var(--space-md);
  flex-shrink: 0;
}

.progress-wrap {
  flex: 1;
  height: 16rpx;
  background-color: #EEEEEE;
  border-radius: var(--cat-radius-pill);
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: linear-gradient(90deg, #66CDAA 0%, #4CD964 100%);
  border-radius: var(--cat-radius-pill);
}

/* ===== 动作卡片 ===== */
.ex-list {
  margin-bottom: var(--space-xl);
}

.ex-card {
  padding: var(--space-lg);
}

.ex-card.done {
  background-color: #FAFFFC;
  border: 2rpx solid rgba(102, 205, 170, 0.2);
}

.ex-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ex-info {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.ex-index {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  color: #222222;
  background-color: #F2F2F2;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: var(--space-md);
}

.ex-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.ex-name {
  font-size: var(--fs-body);
  font-weight: 700;
  color: #222222;
  margin-bottom: var(--space-xs);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ex-tags {
  font-size: 20rpx;
  color: #999999;
}

.ex-actions {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  flex-shrink: 0;
  margin-left: var(--space-md);
}

.ex-history-btn {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  background-color: #F0F6FF;
  border: 2rpx solid rgba(77, 158, 255, 0.25);
  border-radius: 50%;
}

.ex-badge {
  height: 48rpx;
  padding: 0 var(--space-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #FFB54D;
  background-color: #FFF9E8;
  border: 2rpx solid #FFB54D;
  border-radius: var(--cat-radius-pill);
  flex-shrink: 0;
}

.ex-badge.done {
  color: #FFFFFF;
  background: linear-gradient(135deg, #66CDAA 0%, #4CD964 100%);
  border-color: transparent;
}

.ex-badge.doing {
  color: #4D9EFF;
  background-color: #E8F4FF;
  border-color: #4D9EFF;
}

/* ===== 已记录组列表 ===== */
.set-list {
  margin-top: var(--space-md);
  padding: var(--space-sm) var(--space-md);
  background-color: #F8F9FA;
  border-radius: var(--cat-radius-md);
}

.set-row {
  display: flex;
  align-items: center;
  padding: var(--space-sm) 0;
  font-size: 24rpx;
  color: #555555;
  border-bottom: 1rpx solid #EEEEEE;
}

.set-row:last-child {
  border-bottom: none;
}

.set-no {
  width: 110rpx;
  font-weight: 700;
  color: #222222;
  flex-shrink: 0;
}

.set-detail {
  flex: 1;
  font-weight: 600;
}

.set-rpe {
  color: #FF9F1C;
  font-weight: 700;
  margin-left: var(--space-md);
}

.set-fail {
  color: #FF6B6B;
  font-weight: 700;
  margin-left: var(--space-md);
}

.set-rest {
  color: #4D9EFF;
  margin-left: var(--space-md);
}

.set-del {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #FF6B6B;
  background-color: #FFEDED;
  border-radius: 50%;
  margin-left: var(--space-md);
  flex-shrink: 0;
}

/* ===== 编辑区 ===== */
.edit-panel {
  margin-top: var(--space-md);
  border-top: 2rpx dashed #EEEEEE;
  padding-top: var(--space-md);
}

.input-row {
  display: flex;
  gap: var(--space-sm);
}

.input-row2 {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-top: var(--space-sm);
}

.input-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  background-color: #F8F9FA;
  border-radius: var(--cat-radius-md);
  padding: var(--space-sm) var(--space-md);
}

.input-item.rest-item {
  flex: 1;
}

.input-label {
  font-size: 20rpx;
  color: #999999;
  margin-bottom: var(--space-xs);
}

.input {
  font-size: 30rpx;
  font-weight: 700;
  color: #222222;
  height: 48rpx;
  line-height: 48rpx;
}

.fail-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #F8F9FA;
  border-radius: var(--cat-radius-md);
  padding: var(--space-sm) var(--space-md);
  flex-shrink: 0;
}

.fail-switch .input-label {
  margin-bottom: 0;
  margin-right: var(--space-sm);
}

.add-set-row {
  display: flex;
  gap: var(--space-sm);
  margin-top: var(--space-md);
}

.btn-add-set {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  font-weight: 700;
  color: #FF9F1C;
  background-color: #FFF9E8;
  border: 2rpx solid #FFB54D;
  border-radius: var(--cat-radius-pill);
}

.btn-add-set.resting {
  color: #FFFFFF;
  background: linear-gradient(135deg, #FFB54D 0%, #FF9F1C 100%);
  border-color: transparent;
}

.btn-complete {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  font-weight: 700;
  color: #FFFFFF;
  background: linear-gradient(135deg, #66CDAA 0%, #4CD964 100%);
  border-radius: var(--cat-radius-pill);
  box-shadow: 0 4rpx 12rpx rgba(76, 217, 100, 0.25);
}

.note-row {
  margin-top: var(--space-md);
}

.note-input {
  width: 100%;
  min-height: 88rpx;
  padding: var(--space-sm) var(--space-md);
  box-sizing: border-box;
  font-size: 24rpx;
  color: #555555;
  background-color: #F8F9FA;
  border-radius: var(--cat-radius-md);
}

/* ===== 删除动作记录（数据纠错） ===== */
.delete-record {
  margin-top: var(--space-md);
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #FF6B6B;
  background-color: #FFEDED;
  border: 2rpx solid rgba(255, 107, 107, 0.3);
  border-radius: var(--cat-radius-md);
}

/* ===== 空状态 ===== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-3xl) 0;
}

.empty-text {
  font-size: var(--fs-body);
  color: #888888;
}

/* ===== 添加动作 ===== */
.add-more {
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  font-weight: 700;
  color: #4D9EFF;
  background-color: #FFFFFF;
  border: 2rpx solid #4D9EFF;
  border-radius: var(--cat-radius-pill);
  margin-bottom: var(--space-xl);
  box-shadow: var(--cat-shadow-sm);
}

.add-panel {
  padding: var(--space-md);
}

.cats {
  white-space: nowrap;
  margin-bottom: var(--space-md);
}

.cat {
  display: inline-block;
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  color: #888888;
  background-color: #F2F2F2;
  border-radius: var(--cat-radius-pill);
  margin-right: var(--space-sm);
}

.cat.active {
  color: #FFFFFF;
  background: linear-gradient(135deg, #66CDAA 0%, #4CD964 100%);
}

.add-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-md) var(--space-sm);
  border-bottom: 1rpx solid #F2F2F2;
}

.add-item.added {
  opacity: 0.55;
}

.add-item-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.add-item-name {
  font-size: var(--fs-body);
  font-weight: 700;
  color: #222222;
  margin-bottom: var(--space-xs);
}

.add-item-tags {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--cat-radius-pill);
  margin-right: var(--space-xs);
}

.tag-green {
  color: #2E9E63;
  background-color: #EAFBF4;
}

.tag-gray {
  color: #888888;
  background-color: #F2F2F2;
}

.add-item-state {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: linear-gradient(135deg, #66CDAA 0%, #4CD964 100%);
  border-radius: 50%;
  flex-shrink: 0;
  margin-left: var(--space-md);
}

/* ===== 组间休息倒计时（固定底部） ===== */
.rest-banner {
  position: fixed;
  left: var(--space-xl);
  right: var(--space-xl);
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--space-xl);
  background: linear-gradient(135deg, #4D9EFF 0%, #3D8BFF 100%);
  border-radius: var(--cat-radius-pill);
  box-shadow: 0 8rpx 24rpx rgba(77, 158, 255, 0.35);
  z-index: 90;
}

.rest-text {
  font-size: var(--fs-body);
  font-weight: 700;
  color: #FFFFFF;
  font-variant-numeric: tabular-nums;
}

.rest-skip {
  height: 56rpx;
  padding: 0 var(--space-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #4D9EFF;
  background-color: #FFFFFF;
  border-radius: var(--cat-radius-pill);
}

/* ===== 底部：完成训练（固定） ===== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: var(--space-md) var(--space-xl) calc(var(--space-lg) + env(safe-area-inset-bottom));
  background-color: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #EEEEEE;
  z-index: 80;
}

.finish-btn {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-btn);
  font-weight: 800;
  color: #FFFFFF;
  background: linear-gradient(135deg, #FFB54D 0%, #FF9F1C 100%);
  border-radius: var(--cat-radius-pill);
  box-shadow: 0 8rpx 20rpx rgba(255, 159, 28, 0.28);
}

.finish-btn.disabled {
  opacity: 0.5;
  box-shadow: none;
}

/* ===== 通用按钮 ===== */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  color: #FFFFFF;
  background: linear-gradient(135deg, #FFB54D 0%, #FF9F1C 100%);
  border-radius: var(--cat-radius-pill);
  box-shadow: 0 6rpx 16rpx rgba(255, 159, 28, 0.25);
}

.btn-outline {
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  color: #666666;
  background-color: #FFFFFF;
  border: 2rpx solid #EEEEEE;
  border-radius: var(--cat-radius-pill);
  box-shadow: var(--cat-shadow-sm);
}
