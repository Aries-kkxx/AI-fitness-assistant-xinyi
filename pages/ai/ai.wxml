<!-- pages/ai/ai.wxml - AI健身教练聊天页 -->
<view class="chat-page">

  <!-- 未填资料提示条 -->
  <view class="banner" wx:if="{{!hasUser}}" bindtap="onGoUserInfo">
    建议先填写个人资料，AI 推荐会更精准 → 去填写
  </view>

  <!-- 消息列表 -->
  <scroll-view
    class="msg-list"
    scroll-y
    scroll-into-view="{{scrollToId}}"
    scroll-with-animation
  >
    <view
      class="msg-row {{item.role}}"
      wx:for="{{messages}}"
      wx:key="index"
      id="msg-{{index}}"
    >
      <view class="bubble">
        <text class="msg-content" user-select>{{item.content}}</text>
        <!-- 工具调用轨迹（小字展示） -->
        <view class="tool-log" wx:if="{{item.toolLog && item.toolLog.length}}">
          <text class="tool-item" wx:for="{{item.toolLog}}" wx:for-item="t" wx:key="tool">⚙ {{t.tool}}</text>
        </view>
        <!-- 兜底标记 -->
        <view class="fallback-tip" wx:if="{{item.isFallback}}">（AI 暂不可用，以下为本地规则推荐）</view>
      </view>
    </view>

    <!-- 思考中 -->
    <view class="msg-row ai" wx:if="{{sending}}">
      <view class="bubble thinking">正在思考...</view>
    </view>

    <!-- 空状态：快捷问题 -->
    <view class="quick-wrap" wx:if="{{messages.length === 0 && !sending}}">
      <view class="quick-title">你可以问我：</view>
      <scroll-view scroll-x class="quick-row">
        <view class="quick-item" wx:for="{{quickQuestions}}" wx:key="*this" data-text="{{item}}" bindtap="onQuickTap">
          {{item}}
        </view>
      </scroll-view>
    </view>
  </scroll-view>

  <!-- 输入区 -->
  <view class="input-bar">
    <input
      class="chat-input"
      value="{{inputValue}}"
      bindinput="onInput"
      confirm-type="send"
      bindconfirm="onSend"
      placeholder="问问 AI 教练..."
      disabled="{{sending}}"
    />
    <view class="send-btn {{sending ? 'disabled' : ''}}" bindtap="onSend">
      {{sending ? '思考中' : '发送'}}
    </view>
  </view>
</view>
