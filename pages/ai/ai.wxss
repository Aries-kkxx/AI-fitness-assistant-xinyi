/* pages/ai/ai.wxss - AI健身教练聊天页样式 */

.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

/* 顶部提示条 */
.banner {
  background-color: #fff7e6;
  color: #b26a00;
  font-size: 24rpx;
  text-align: center;
  padding: 14rpx 20rpx;
}

/* 消息列表 */
.msg-list {
  flex: 1;
  overflow: hidden;
  padding: 24rpx 30rpx;
  box-sizing: border-box;
}

.msg-row {
  display: flex;
  margin-bottom: 24rpx;
}

/* 用户消息靠右 */
.msg-row.user {
  justify-content: flex-end;
}

/* 气泡 */
.bubble {
  max-width: 80%;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

.msg-row.user .bubble {
  background-color: #07c160;
  color: #ffffff;
  border-bottom-right-radius: 4rpx;
}

.msg-row.ai .bubble {
  background-color: #ffffff;
  color: #333333;
  border-bottom-left-radius: 4rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 保留换行 */
.msg-content {
  white-space: pre-wrap;
}

/* 工具调用轨迹 */
.tool-log {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  display: flex;
  flex-wrap: wrap;
}

.msg-row.user .tool-log {
  border-top-color: rgba(255, 255, 255, 0.2);
}

.tool-item {
  font-size: 20rpx;
  color: #999999;
  margin-right: 12rpx;
}

.msg-row.user .tool-item {
  color: rgba(255, 255, 255, 0.8);
}

/* 兜底标记 */
.fallback-tip {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #b26a00;
}

/* 思考中 */
.thinking {
  color: #999999 !important;
}

/* 快捷问题 */
.quick-wrap {
  margin-top: 60rpx;
  text-align: center;
}

.quick-title {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 20rpx;
}

.quick-row {
  white-space: nowrap;
}

.quick-item {
  display: inline-block;
  font-size: 26rpx;
  color: #07c160;
  background-color: #ffffff;
  border: 2rpx solid #07c160;
  border-radius: 32rpx;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
}

/* 输入区 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #eeeeee;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  background-color: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

.send-btn {
  margin-left: 20rpx;
  background-color: #07c160;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 36rpx;
  padding: 14rpx 36rpx;
}

.send-btn.disabled {
  background-color: #9ae6bd;
}
