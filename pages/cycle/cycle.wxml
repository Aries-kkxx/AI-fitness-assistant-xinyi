<!-- pages/cycle/cycle.wxml - 训练周期页 -->
<view class="page sky-bg">

  <!-- 自定义导航栏 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="onBack">‹</view>
    <text class="nav-title">训练周期</text>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 创建按钮：放在胶囊按钮（关闭小程序组件）下方，不占导航栏右上角 -->
  <view class="page-create" bindtap="onGoCreate">＋ 创建</view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <block wx:else>
    <!-- 无活跃周期 -->
    <block wx:if="{{!hasCycle}}">
      <view class="card empty-card">
        <cat-illustration pose="empty" size="160" />
        <text class="empty-title">还没有训练周期</text>
        <text class="empty-sub">创建 4~8 周训练周期：自动渐进增加负荷、中段减量周、每周与周期总结</text>
        <view class="btn-primary create-btn" bindtap="onGoCreate">创建周期</view>
      </view>

      <!-- 历史周期 -->
      <view class="card" wx:if="{{cycles.length > 0}}">
        <view class="card-title">历史周期</view>
        <view class="his-cycle" wx:for="{{cycles}}" wx:key="_id">
          <view class="his-cycle-info">
            <text class="his-cycle-name">{{item.name}}</text>
            <text class="his-cycle-meta">{{item.goal}} · {{item.start_date}} ~ {{item.end_date}} · {{item.total_weeks}} 周</text>
          </view>
          <text class="his-cycle-status">{{item.status === 'completed' ? '已完成' : '已放弃'}}</text>
        </view>
      </view>
    </block>

    <!-- 活跃周期 -->
    <block wx:else>
      <!-- 周期卡 -->
      <view class="card cycle-card">
        <view class="cycle-head">
          <text class="cycle-name">{{cycle.name}}</text>
          <text class="cycle-status">{{cycle.status === 'completed' ? '已完成' : '进行中'}}</text>
        </view>
        <view class="cycle-meta">{{cycle.goal}} · {{cycle.start_date}} ~ {{cycle.end_date}} · 每周 {{cycle.weekly_frequency}} 次</view>
        <view class="cycle-progress">
          <text class="cycle-week">第 {{currentWeek}} / {{cycle.total_weeks}} 周</text>
          <view class="cycle-bar">
            <view class="cycle-inner" style="width: {{weekPercent}}%;"></view>
          </view>
        </view>
        <view class="cycle-deload" wx:if="{{weekPlan && weekPlan.deload}}">
          <image class="deload-icon" src="/assets/icons_pet/羊.png" mode="aspectFill" />
          <text class="deload-text">本周是减量周：{{weekPlan.deloadNote}}</text>
        </view>
        <view class="cycle-actions">
          <view class="btn-outline" bindtap="onAbandon">放弃周期</view>
        </view>
      </view>

      <!-- 本周计划 -->
      <view class="card" wx:if="{{weekPlan}}">
        <view class="card-head">
          <text class="card-title">本周计划</text>
          <text class="card-sub">{{adjustText}}</text>
        </view>
        <view class="week-days">
          <view class="week-day {{item.isToday ? 'today' : ''}} {{item.isRest ? 'rest' : ''}}" wx:for="{{weekDays}}" wx:key="day">
            <text class="week-day-name">{{item.weekName}}</text>
            <text class="week-day-count" wx:if="{{!item.isRest}}">{{item.count}}个</text>
          </view>
        </view>

        <view class="today-ex" wx:if="{{todayExercises.length > 0}}">
          <text class="today-ex-title">今日动作（第 {{currentWeek}} 周）</text>
          <view class="today-ex-item" wx:for="{{todayExercises}}" wx:key="_id">
            <text class="today-ex-name">{{item.name}}</text>
            <text class="today-ex-tags">{{item.sets}}组 × {{item.reps}}{{item.repsUnit}}</text>
            <text class="today-ex-weight" wx:if="{{item.suggestedWeightKg}}">建议 {{item.suggestedWeightKg}}kg</text>
          </view>
          <view class="today-go" bindtap="onGoWorkout">去训练 ›</view>
        </view>
      </view>

      <!-- 每周总结 -->
      <view class="card" wx:if="{{summaries.length > 0}}">
        <view class="card-title">每周总结</view>
        <view class="week-summary" wx:for="{{summaries}}" wx:key="week_no" data-index="{{index}}" bindtap="onToggleSummary">
          <view class="ws-head">
            <text class="ws-title">第 {{item.week_no}} 周</text>
            <text class="ws-rate">{{item.summary.completion_rate}}% 完成</text>
            <text class="ws-arrow">{{item.expanded ? '▴' : '▾'}}</text>
          </view>
          <view class="ws-stats">
            <text>训练 {{item.summary.training_days}} 天</text>
            <text>容量 {{item.summary.total_volume}}kg</text>
            <text wx:if="{{item.summary.pr_count > 0}}">🎉 PR ×{{item.summary.pr_count}}</text>
            <text wx:if="{{item.summary.pain_detected}}">⚠️ 有不适</text>
          </view>
          <view class="ws-detail" wx:if="{{item.expanded}}">
            <text class="ws-line">表现：{{item.ai_summary.performance}}</text>
            <text class="ws-line">进步：{{item.ai_summary.improvements}}</text>
            <text class="ws-line">问题：{{item.ai_summary.problems}}</text>
            <text class="ws-line">下周建议：{{item.ai_summary.next_week_advice}}</text>
          </view>
        </view>
      </view>

      <!-- 周期总结 -->
      <view class="card summary-card" wx:if="{{finalSummary}}">
        <view class="card-title">周期总结</view>
        <view class="fs-stats">
          <view class="fs-item">
            <text class="fs-value">{{finalSummary.summary.completion_rate}}%</text>
            <text class="fs-label">完成率</text>
          </view>
          <view class="fs-item">
            <text class="fs-value">{{finalSummary.summary.total_training_days}}</text>
            <text class="fs-label">训练天数</text>
          </view>
          <view class="fs-item">
            <text class="fs-value">{{finalSummary.summary.total_volume}}kg</text>
            <text class="fs-label">总容量</text>
          </view>
          <view class="fs-item">
            <text class="fs-value">{{finalSummary.summary.pr_total}}</text>
            <text class="fs-label">新纪录</text>
          </view>
        </view>
        <view class="fs-line">{{finalSummary.ai_summary.summary_text}}</view>
        <view class="fs-line">进步：{{finalSummary.ai_summary.improvement}}</view>
        <view class="fs-line">问题：{{finalSummary.ai_summary.problem}}</view>
        <view class="fs-line">下周期：{{finalSummary.ai_summary.next_cycle_advice}}</view>
      </view>

      <!-- 历史周期 -->
      <view class="card" wx:if="{{cycles.length > 1}}">
        <view class="card-title">历史周期</view>
        <view class="his-cycle" wx:for="{{cycles}}" wx:key="_id">
          <view class="his-cycle-info">
            <text class="his-cycle-name">{{item.name}}</text>
            <text class="his-cycle-meta">{{item.goal}} · {{item.start_date}} ~ {{item.end_date}} · {{item.total_weeks}} 周</text>
          </view>
          <text class="his-cycle-status {{item.status}}">{{item.status === 'completed' ? '已完成' : '已放弃'}}</text>
        </view>
      </view>
    </block>
  </block>
</view>
