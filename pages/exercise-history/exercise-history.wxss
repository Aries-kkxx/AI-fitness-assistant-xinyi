/* pages/exercise-history/exercise-history.wxss - 动作历史与表现分析页 */

.page {
  min-height: 100vh;
  padding: calc(88rpx + env(safe-area-inset-top)) var(--space-xl) calc(var(--space-3xl) + env(safe-area-inset-bottom));
}

.sky-bg {
  background: linear-gradient(180deg, #E8F7FF 0%, #F7F8FA 30%, #F7F8FA 100%);
}

/* ===== 自定义导航栏 ===== */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: calc(88rpx + env(safe-area-inset-top));
  padding-top: env(safe-area-inset-top);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: var(--space-md);
  padding-right: var(--space-md);
  background-color: #E8F7FF;
  z-index: 100;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #222222;
  font-weight: 700;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #222222;
  max-width: 480rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-placeholder {
  width: 60rpx;
}

/* ===== 通用 ===== */
.card {
  background-color: #FFFFFF;
  border-radius: var(--cat-radius-lg);
  padding: var(--space-xl);
  margin-bottom: var(--space-xl);
  box-shadow: var(--cat-shadow-md);
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: var(--space-md);
}

.card-title {
  font-size: var(--fs-card-title);
  font-weight: 800;
  color: #222222;
}

.card-sub {
  font-size: 20rpx;
  color: #999999;
}

.loading {
  text-align: center;
  padding: var(--space-3xl);
  color: #999999;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-3xl) var(--space-xl);
  margin-top: var(--space-2xl);
}

.empty-title {
  margin-top: var(--space-md);
  font-size: var(--fs-card-title);
  font-weight: 700;
  color: #222222;
}

.empty-sub {
  margin-top: var(--space-sm);
  font-size: var(--fs-caption);
  color: #888888;
  text-align: center;
  line-height: 1.6;
}

.empty-btn {
  margin-top: var(--space-xl);
  height: 80rpx;
  padding: 0 var(--space-3xl);
}

/* ===== PR 卡 ===== */
.pr-card {
  margin-top: var(--space-xl);
  background: linear-gradient(135deg, #FFF9E8 0%, #FFF3D6 100%);
  border: 2rpx solid rgba(255, 209, 102, 0.3);
}

.pr-grid {
  display: flex;
  gap: var(--space-md);
}

.pr-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: var(--cat-radius-md);
  padding: var(--space-lg) var(--space-sm);
  box-shadow: var(--cat-shadow-sm);
}

.pr-label {
  font-size: 22rpx;
  color: #999999;
  margin-bottom: var(--space-xs);
}

.pr-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #FF9F1C;
}

.pr-sub {
  margin-top: var(--space-xs);
  font-size: 20rpx;
  color: #BBBBBB;
  text-align: center;
}

/* ===== 最近 vs 上次 ===== */
.cmp-head,
.cmp-row {
  display: flex;
  align-items: center;
  padding: var(--space-sm) 0;
}

.cmp-head {
  font-size: 22rpx;
  color: #999999;
}

.cmp-row {
  font-size: 26rpx;
  border-top: 1rpx solid #F5F5F5;
}

.cmp-col {
  flex: 1;
  text-align: center;
}

.cmp-label {
  flex: 1;
  color: #555555;
  font-weight: 600;
}

.cmp-val {
  flex: 1;
  text-align: center;
  font-weight: 700;
  color: #222222;
}

.cmp-val.prev {
  color: #999999;
  font-weight: 500;
}

.cmp-trend {
  width: 48rpx;
  text-align: center;
  font-weight: 800;
}

.cmp-trend.up {
  color: #FF6B6B;
}

.cmp-trend.down {
  color: #4CD964;
}

/* ===== 建议卡 ===== */
.suggest-card {
  background: linear-gradient(135deg, #EAFBF4 0%, #D8F5E7 100%);
  border: 2rpx solid rgba(102, 205, 170, 0.35);
}

.suggest-main {
  display: flex;
  flex-direction: column;
}

.suggest-action {
  font-size: 36rpx;
  font-weight: 800;
  color: #1F6B4C;
  margin-bottom: var(--space-sm);
}

.suggest-action.increase_weight,
.suggest-action.increase_reps {
  color: #FF9F1C;
}

.suggest-action.reduce {
  color: #FF6B6B;
}

.suggest-reason {
  font-size: var(--fs-body);
  color: #44684F;
  line-height: 1.6;
}

.suggest-nums {
  display: flex;
  gap: var(--space-md);
  margin-top: var(--space-lg);
}

.num-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.75);
  border-radius: var(--cat-radius-md);
  padding: var(--space-md);
}

.num-label {
  font-size: 20rpx;
  color: #4C9C78;
  margin-bottom: var(--space-xs);
}

.num-value {
  font-size: 32rpx;
  font-weight: 800;
  color: #1F6B4C;
}

.suggest-near {
  margin-top: var(--space-md);
  font-size: 22rpx;
  color: #FF9F1C;
  font-weight: 600;
}

/* ===== 趋势图 ===== */
.chart-canvas {
  width: 100%;
  height: 260rpx;
}

/* ===== 最近训练列表 ===== */
.his-row {
  display: flex;
  align-items: center;
  padding: var(--space-md) 0;
  font-size: 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.his-row:last-child {
  border-bottom: none;
}

.his-head {
  font-size: 22rpx;
  color: #999999;
  border-bottom: 1rpx solid #EEEEEE;
}

.his-col {
  flex: 1;
  text-align: center;
  color: #555555;
}

.his-col.date {
  flex: 1.4;
  text-align: left;
  color: #222222;
  font-weight: 600;
}

.his-col.vol {
  color: #2E9E63;
  font-weight: 600;
}

/* ===== 通用按钮 ===== */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  color: #FFFFFF;
  background: linear-gradient(135deg, #FFB54D 0%, #FF9F1C 100%);
  border-radius: var(--cat-radius-pill);
  box-shadow: 0 6rpx 16rpx rgba(255, 159, 28, 0.25);
}
