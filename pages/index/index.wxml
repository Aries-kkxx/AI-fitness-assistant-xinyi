<!-- pages/index/index.wxml - 首页（卡通猫咪健身风格 · 最新参考图 1:1 还原） -->
<view class="page sky-bg">
  <!-- 顶部问候区 -->
  <view class="hello-section">
    <view class="hello-text">
      <view class="hello-row">
        <text class="hello-hi" wx:if="{{user}}">Hi, {{user.nickname}}</text>
        <text class="hello-hi" wx:else>Hi</text>
        <text class="hello-hand">👋</text>
      </view>
      <text class="hello-sub">今天也要元气满满哦</text>
    </view>
    <view class="hello-deco">
      <cat-illustration pose="home" size="260" class="hello-cat" />
    </view>
  </view>
  <!-- 欣一今日建议（身体状态 + 训练/恢复/饮水建议，本地规则生成） -->
  <view class="card advice-card" wx:if="{{advice && advice.hasUser}}">
    <view class="advice-head">
      <text class="card-title">欣一今日建议</text>
      <view class="advice-state {{advice.trainingState.state}}">{{advice.trainingState.stateText}}</view>
    </view>

    <!-- 今日身体状态：未记录 → 引导记录；已记录 → 展示评分 -->
    <view class="advice-recovery" wx:if="{{advice.hasRecovery}}" bindtap="onGoRecovery">
      <view class="advice-recovery-head">
        <text class="advice-recovery-title">今日身体状态</text>
        <text class="advice-edit">编辑 ›</text>
      </view>
      <view class="advice-scores">
        <view class="advice-score" wx:for="{{advice.recoveryItems}}" wx:key="label">
          <text class="advice-score-label">{{item.label}}</text>
          <text class="advice-score-value">{{item.value}}</text>
        </view>
      </view>
    </view>
    <view class="advice-record" wx:else bindtap="onGoRecovery">
      <view class="advice-record-text">
        <text class="advice-record-title">记录今日身体状态</text>
        <text class="advice-record-sub">睡眠 · 疲劳 · 酸痛 · 意愿，约 10 秒完成</text>
      </view>
      <view class="advice-record-btn">去记录 ›</view>
    </view>

    <!-- 训练建议 -->
    <view class="advice-line">
      <text class="advice-icon">🏋️</text>
      <text class="advice-text">{{advice.trainingText}}</text>
    </view>

    <!-- 恢复建议 -->
    <view class="advice-line" wx:for="{{advice.recoveryTips}}" wx:key="*this">
      <text class="advice-icon">💤</text>
      <text class="advice-text">{{item}}</text>
    </view>

    <!-- 饮水建议 -->
    <view class="advice-line" bindtap="onGoWater">
      <text class="advice-icon">💧</text>
      <text class="advice-text">{{advice.waterText}}</text>
    </view>

    <!-- 一句话总结 -->
    <view class="advice-summary">「{{advice.summary}}」</view>
  </view>
  <!-- 今日训练 Hero 大卡片 -->
  <view class="card hero-card {{workout.isRestDay ? 'rest' : ''}}" wx:if="{{hasUser && workout}}">
    <view class="hero-main">
      <text class="hero-label">今日训练</text>
      <block wx:if="{{workout.isRestDay}}">
        <text class="hero-parts">今天好好休息</text>
        <view class="hero-meta"><text>恢复日，明天继续加油 💪</text></view>
      </block>
      <block wx:else>
        <text class="hero-parts">{{workout.partsText}}</text>
        <view class="hero-meta">
          <text>{{workout.count}} 个动作</text>
          <text class="hero-dot">·</text>
          <text>约 {{workout.totalMinutes}} 分钟</text>
        </view>
        <view class="hero-btn" bindtap="onGoWorkout">开始训练</view>
      </block>
    </view>
    <view class="hero-deco">
      <cat-illustration pose="workout" size="200" class="hero-cat" />
    </view>
  </view>
  <!-- 今日饮水卡片 -->
  <view class="card water-card" wx:if="{{water}}">
    <view class="water-content">
      <view class="water-main">
        <text class="card-title water-title">今日饮水</text>
        <view class="water-big">
          <text class="water-big-num">{{water.total}}</text>
          <text class="water-big-sep">/</text>
          <text class="water-big-target">{{water.target}}ml</text>
        </view>
        <view class="water-cups">{{water.cups}} / {{water.dailyCups}} 杯</view>
        <view class="water-progress-row">
          <view class="water-progress">
            <view class="water-inner" style="width: {{water.percent}}%;"></view>
          </view>
          <text class="water-percent">{{water.percent}}%</text>
        </view>
      </view>
      <view class="water-deco">
        <cat-illustration pose="water" size="180" class="water-cat" />
      </view>
    </view>
    <view class="water-actions">
      <view class="drink-btn" bindtap="onDrinkOne">喝一杯</view>
      <view class="add-btn" bindtap="onGoWaterAdd">添加记录</view>
    </view>
  </view>
  <!-- 本周概览 -->
  <view class="card week-card" wx:if="{{weekOverview}}">
    <view class="week-main">
      <text class="card-title">本周概览</text>
      <view class="week-stats">
        <text class="week-line">本周训练 {{weekOverview.workoutDays}} 次</text>
        <text class="week-line">饮水达标 {{weekOverview.waterDoneDays}} 天</text>
      </view>
    </view>
    <view class="week-deco">
      <cat-illustration pose="calendar" size="180" class="week-cat" />
    </view>
  </view>
  <!-- 身体数据卡片 -->
  <view class="card body-card">
    <view class="card-title">我的身体数据</view>
    <!-- 未填写资料 -->
    <block wx:if="{{!hasUser}}">
      <view class="no-data">还没有身体数据，填写资料后为你计算 BMI 并生成训练计划</view>
      <view class="btn-outline fill-btn" bindtap="onGoUserInfo">填写资料</view>
    </block>
    <block wx:else>
      <view class="body-row">
        <view class="body-item">
          <text class="body-num">{{user.height}}</text>
          <text class="body-label">身高 cm</text>
        </view>
        <view class="body-item">
          <text class="body-num">{{user.weight}}</text>
          <text class="body-label">体重 kg</text>
        </view>
        <view class="body-item">
          <text class="body-num green">{{user.bmi}}</text>
          <text class="body-label">BMI（{{user.bmiCategory}}）</text>
        </view>
        <view class="body-item">
          <text class="body-num goal">{{user.goal}}</text>
          <text class="body-label">健身目标</text>
        </view>
      </view>
      <view class="body-tip">BMI 仅作参考，不作为医疗诊断依据</view>
    </block>
  </view>
  <!-- 体重趋势卡片 -->
  <view class="card weight-card safe-bottom">
    <view class="card-title">体重趋势</view>
    <block wx:if="{{weightStats && weightStats.hasData}}">
      <view class="weight-current">
        <text class="weight-num">{{weightStats.current}}</text>
        <text class="weight-unit">kg</text>
        <view class="weight-delta" wx:if="{{weightStats.delta !== null}}">
          <text>{{weightStats.deltaText}}</text>
        </view>
        <text class="weight-days">过去30天</text>
      </view>
      <canvas type="2d" id="home-weight-chart" class="weight-chart"></canvas>
    </block>
    <block wx:else>
      <view class="no-data">记录体重，查看你的变化曲线</view>
    </block>
    <view class="btn-outline weight-btn" bindtap="onGoWeight">记录 / 查看体重 ›</view>
  </view>
</view>
<!-- 全局AI悬浮球 -->
<float-ball />