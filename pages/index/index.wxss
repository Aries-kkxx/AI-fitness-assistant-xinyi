/* pages/index/index.wxss - 首页样式 */

.page {
  padding: 30rpx;
}

/* ===== 身体数据卡片 ===== */
.body-row {
  display: flex;
}

.body-item {
  flex: 1;
  text-align: center;
}

.body-num {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #333333;
}

.body-num.green {
  color: #07c160;
  font-size: 28rpx;
  padding-top: 8rpx;
}

.body-label {
  display: block;
  font-size: 22rpx;
  color: #999999;
  margin-top: 6rpx;
}

.body-tip {
  font-size: 20rpx;
  color: #cccccc;
  text-align: center;
  margin-top: 16rpx;
}

.no-data {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  padding: 20rpx 0;
}

.fill-btn {
  width: 50%;
  margin: 0 auto;
  font-size: 28rpx;
  padding: 14rpx 0;
}

/* ===== 今日训练卡片 ===== */
.workout-parts {
  font-size: 44rpx;
  font-weight: 700;
  color: #07c160;
  margin-bottom: 12rpx;
}

.workout-meta {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 24rpx;
}

.go-btn {
  font-size: 28rpx;
  padding: 16rpx 0;
}

/* ===== 今日饮水卡片 ===== */
.water-nums {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.water-ml {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
}

.water-cups {
  font-size: 30rpx;
  color: #07c160;
}

.water-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
}

.water-percent {
  font-size: 26rpx;
  color: #999999;
}

/* 卡片内的小号主按钮 */
.drink-btn {
  width: 200rpx;
  padding: 14rpx 0;
  font-size: 28rpx;
}

.water-more {
  margin-top: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999999;
}
