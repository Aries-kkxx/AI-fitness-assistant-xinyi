<!-- pages/profile/profile.wxml - 我的页 -->
<view class="page">

  <!-- 用户信息卡片 -->
  <view class="card user-card">
    <view class="avatar">{{user ? user.nickname[0] : '客'}}</view>
    <view class="user-info">
      <text class="user-name">{{user ? user.nickname : '未填写资料'}}</text>
      <text class="user-desc" wx:if="{{user}}">
        {{user.gender}} · {{user.age}}岁 · 目标{{user.goal}} · {{user.equipment}}
      </text>
      <text class="user-desc" wx:else>填写资料后开启个性化训练推荐</text>
    </view>
    <view class="edit-link" bindtap="onGoUserInfo">编辑 ›</view>
  </view>

  <!-- 功能菜单 -->
  <view class="card menu-card">
    <view class="menu-row" bindtap="onGoUserInfo">
      <image class="menu-icon-img" src="/assets/icons_pet/布偶猫.png" mode="aspectFill" />
      <text class="menu-name">我的资料</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="onGoStats">
      <image class="menu-icon-img" src="/assets/icons_pet/仓鼠.png" mode="aspectFill" />
      <text class="menu-name">健身数据中心</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="onGoFitnessMemory">
      <image class="menu-icon-img" src="/assets/icons_pet/橘猫.png" mode="aspectFill" />
      <text class="menu-name">欣一记住的事情</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="onGoCycle">
      <image class="menu-icon-img" src="/assets/icons_pet/边牧.png" mode="aspectFill" />
      <text class="menu-name">训练周期</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="onGoWeight">
      <image class="menu-icon-img" src="/assets/icons_pet/荷兰猪.png" mode="aspectFill" />
      <text class="menu-name">体重记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="onGoWaterSetting">
      <image class="menu-icon-img" src="/assets/icons_pet/羊.png" mode="aspectFill" />
      <text class="menu-name">饮水设置</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>

<!-- 全局AI悬浮球 -->
<float-ball />

