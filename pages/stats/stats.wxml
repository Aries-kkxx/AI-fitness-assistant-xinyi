<!-- pages/stats/stats.wxml - 个人健身成长档案 -->
<view class="page sky-bg">

  <!-- 自定义导航栏 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="onBack">‹</view>
    <text class="nav-title">健身档案</text>
    <view class="nav-placeholder"></view>
  </view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <block wx:else>
    <!-- 训练 -->
    <view class="card">
      <view class="card-head">
        <view class="card-title-row"><image class="card-title-icon" src="/assets/icons_pet/柴犬.png" mode="aspectFill" /><text class="card-title">训练</text></view>
        <text class="card-link" bindtap="onGoWorkout">去训练 ›</text>
      </view>
      <view class="stat-row">
        <view class="stat-item">
          <text class="stat-num">{{training.week}}</text>
          <text class="stat-label">本周 · 次</text>
        </view>
        <view class="stat-item">
          <text class="stat-num">{{training.month}}</text>
          <text class="stat-label">本月 · 次</text>
        </view>
        <view class="stat-item">
          <text class="stat-num">{{training.total}}</text>
          <text class="stat-label">累计 · 次</text>
        </view>
      </view>
      <view class="stat-row">
        <view class="stat-item">
          <text class="stat-num green">{{training.completionRate}}%</text>
          <text class="stat-label">近7天完成率</text>
        </view>
        <view class="stat-item">
          <text class="stat-num green">{{training.totalVolume}}kg</text>
          <text class="stat-label">总容量</text>
        </view>
        <view class="stat-item">
          <text class="stat-num green">{{training.avgDuration}}</text>
          <text class="stat-label">平均时长·分</text>
        </view>
        <view class="stat-item">
          <text class="stat-num orange">{{training.prCount}}</text>
          <text class="stat-label">个人纪录</text>
        </view>
      </view>
      <view class="stat-tip" wx:if="{{training.total === 0}}">还没有训练记录，完成一次训练后这里会更新</view>
    </view>

    <!-- 体重 -->
    <view class="card">
      <view class="card-head">
        <view class="card-title-row"><image class="card-title-icon" src="/assets/icons_pet/田园犬.png" mode="aspectFill" /><text class="card-title">体重</text></view>
        <text class="card-link" bindtap="onGoWeight">记录 ›</text>
      </view>
      <block wx:if="{{weight.hasData}}">
        <view class="weight-hero">
          <text class="weight-num">{{weight.current}}</text>
          <text class="weight-unit">kg</text>
          <view class="weight-deltas">
            <text class="weight-delta">30天：{{weightDelta30}}</text>
            <text class="weight-delta">90天：{{weightDelta90}}</text>
          </view>
        </view>
        <view class="stat-tip">共记录 {{weight.count}} 次</view>
      </block>
      <view class="stat-tip" wx:else>还没有体重记录，去记录一次吧</view>
    </view>

    <!-- 身体 -->
    <view class="card">
      <view class="card-head">
        <view class="card-title-row"><image class="card-title-icon" src="/assets/icons_pet/白猫.png" mode="aspectFill" /><text class="card-title">身体</text></view>
        <text class="card-link" bindtap="onGoBodyMeasure">记录围度 ›</text>
      </view>
      <view class="stat-row">
        <view class="stat-item">
          <text class="stat-num">{{body.bmi ? body.bmi : '—'}}</text>
          <text class="stat-label">BMI</text>
        </view>
        <view class="stat-item">
          <text class="stat-num">{{body.bodyFat ? body.bodyFat + '%' : '—'}}</text>
          <text class="stat-label">体脂率</text>
        </view>
        <view class="stat-item">
          <text class="stat-num">{{body.waist ? body.waist + 'cm' : '—'}}</text>
          <text class="stat-label">腰围</text>
        </view>
      </view>
      <view class="stat-row" wx:if="{{body.hasData}}">
        <view class="stat-item">
          <text class="stat-num small">{{body.chest ? body.chest : '—'}}</text>
          <text class="stat-label">胸围</text>
        </view>
        <view class="stat-item">
          <text class="stat-num small">{{body.hip ? body.hip : '—'}}</text>
          <text class="stat-label">臀围</text>
        </view>
        <view class="stat-item">
          <text class="stat-num small">{{body.arm ? body.arm : '—'}}</text>
          <text class="stat-label">手臂围</text>
        </view>
        <view class="stat-item">
          <text class="stat-num small">{{body.thigh ? body.thigh : '—'}}</text>
          <text class="stat-label">大腿围</text>
        </view>
      </view>
      <view class="stat-tip" wx:else>记录身体围度（腰/胸/臀/臂/腿），追踪体型变化</view>
    </view>

    <!-- 饮水 -->
    <view class="card">
      <view class="card-head">
        <view class="card-title-row"><image class="card-title-icon" src="/assets/icons_pet/蓝猫.png" mode="aspectFill" /><text class="card-title">饮水</text></view>
        <text class="card-link" bindtap="onGoWater">去喝水 ›</text>
      </view>
      <view class="stat-row">
        <view class="stat-item">
          <text class="stat-num">{{water.monthTotal}}</text>
          <text class="stat-label">本月总量·ml</text>
        </view>
        <view class="stat-item">
          <text class="stat-num">{{water.avgPerDay}}</text>
          <text class="stat-label">日均·ml</text>
        </view>
        <view class="stat-item">
          <text class="stat-num green">{{water.goalDays}}</text>
          <text class="stat-label">本月达标·天</text>
        </view>
        <view class="stat-item">
          <text class="stat-num orange">{{water.streakDays}}</text>
          <text class="stat-label">最长连续达标</text>
        </view>
      </view>
    </view>

    <!-- 恢复 -->
    <view class="card">
      <view class="card-head">
        <view class="card-title-row"><image class="card-title-icon" src="/assets/icons_pet/黑猫.png" mode="aspectFill" /><text class="card-title">恢复</text></view>
        <text class="card-link" bindtap="onGoCycle">训练周期 ›</text>
      </view>
      <view class="stat-row" wx:if="{{recovery.avgSleep > 0}}">
        <view class="stat-item">
          <text class="stat-num">{{recovery.avgFatigue}}</text>
          <text class="stat-label">平均疲劳 /5</text>
        </view>
        <view class="stat-item">
          <text class="stat-num">{{recovery.avgSleep}}</text>
          <text class="stat-label">平均睡眠 /5</text>
        </view>
        <view class="stat-item">
          <text class="stat-num">{{recovery.avgSoreness}}</text>
          <text class="stat-label">平均酸痛 /5</text>
        </view>
        <view class="stat-item">
          <text class="stat-num orange">{{recovery.painDays}}</text>
          <text class="stat-label">不适反馈·天</text>
        </view>
      </view>
      <view class="stat-tip" wx:else>还没有恢复记录，去「每日状态」记录身体感受</view>
    </view>

    <!-- 趋势图 -->
    <view class="card">
      <view class="card-head">
        <view class="card-title-row"><image class="card-title-icon" src="/assets/icons_pet/金毛.png" mode="aspectFill" /><text class="card-title">趋势（近 30 天）</text></view>
      </view>
      <view class="trend-tabs">
        <view
          class="trend-tab {{activeTrend === index ? 'active' : ''}}"
          wx:for="{{trendTabs}}"
          wx:key="key"
          data-index="{{index}}"
          bindtap="onTrendTap"
        >{{item.label}}</view>
      </view>
      <canvas type="2d" id="archive-chart" class="chart-canvas"></canvas>
      <view class="stat-tip center" wx:if="{{trendEmpty}}">近 30 天暂无数据，开始记录后这里会显示趋势</view>
    </view>

    <!-- 智能数据分析 -->
    <view class="card ai-card">
      <view class="card-head">
        <view class="card-title-row"><image class="card-title-icon" src="/assets/icons_pet/无毛猫.png" mode="aspectFill" /><text class="card-title">智能数据分析</text></view>
      </view>
      <view class="ai-desc">智能基于你的真实统计数据（训练/体重/恢复/饮水/纪录）分析进步与问题</view>
      <view class="btn-primary ai-btn {{aiLoading ? 'disabled' : ''}}" bindtap="onAiAnalyze">
        {{aiLoading ? '分析中...' : '开始分析'}}
      </view>
      <view class="ai-result" wx:if="{{aiResult}}">{{aiResult}}</view>
    </view>

    <!-- 成就 -->
    <view class="card">
      <view class="card-head">
        <view class="card-title-row"><image class="card-title-icon" src="/assets/icons_pet/法斗.png" mode="aspectFill" /><text class="card-title">个人成就</text></view>
        <text class="card-link">{{unlockedCount}}/{{achievements.list.length}} 已解锁</text>
      </view>
      <view class="ach-grid">
        <view class="ach-item {{item.unlocked ? 'unlocked' : ''}}" wx:for="{{achievements.list}}" wx:key="key">
          <text class="ach-icon">{{item.icon}}</text>
          <text class="ach-title">{{item.title}}</text>
          <view class="ach-progress" wx:if="{{!item.unlocked}}">
            <view class="ach-progress-inner" style="width: {{item.progress}}%;"></view>
          </view>
          <text class="ach-date" wx:if="{{item.unlocked}}">✓</text>
        </view>
      </view>
    </view>

    <!-- 数据管理 -->
    <view class="card">
      <view class="card-head">
        <view class="card-title-row"><image class="card-title-icon" src="/assets/icons_pet/腊肠犬.png" mode="aspectFill" /><text class="card-title">数据管理</text></view>
      </view>
      <view class="data-row" bindtap="onGoDataManage">
        <text class="data-name">导出 / 导入数据</text>
        <text class="data-sub">备份或迁移你的全部记录（JSON / CSV）</text>
        <text class="data-arrow">›</text>
      </view>
    </view>
  </block>
</view>

