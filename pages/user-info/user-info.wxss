/* pages/user-info/user-info.wxss - 用户信息设置页样式 */

.page {
  padding: 30rpx 30rpx 200rpx; /* 底部预留固定保存栏空间 */
}

/* 表单一行 */
.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 30rpx;
  color: #333333;
  flex-shrink: 0;
}

.form-value,
.form-input {
  font-size: 30rpx;
  text-align: right;
  width: 380rpx;
  line-height: 42rpx;
  min-height: 42rpx;
}

.form-value {
  color: #ff9f1c;
  font-weight: 600;
}

/* 与输入框样式一致：深灰色、常规字重 */
.form-value-plain {
  color: #333333;
  font-weight: 400;
}

.form-input {
  color: #333333;
  background-color: transparent;
  border: none;
  outline: none;
  padding: 0;
  margin: 0;
  height: 42rpx;
}

/* BMI 预览行 */
.bmi-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
}

.bmi-label {
  font-size: 30rpx;
  color: #333333;
}

.bmi-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #ff9f1c;
}

.bmi-tip {
  font-size: 22rpx;
  color: #bbbbbb;
}

/* 固定底部保存栏（滚动不跟随） */
.save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ffffff;
  padding: 16rpx 30rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.save-btn {
  margin-top: 0;
}
