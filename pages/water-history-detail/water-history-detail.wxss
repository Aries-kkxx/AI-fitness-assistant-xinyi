/* pages/water-history-detail/water-history-detail.wxss - 饮水历史详情页样式（卡通漫画风格） */

.page {
  padding: 30rpx;
}

.loading {
  text-align: center;
  color: #999999;
  padding: 100rpx 0;
}

/* 统计行 */
.detail-row {
  display: flex;
  margin-bottom: 24rpx;
}

.detail-item {
  flex: 1;
  text-align: center;
}

.detail-num {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.detail-num.green {
  color: #2e9e5b;
}

.detail-label {
  display: block;
  font-size: 22rpx;
  color: #999999;
  margin-top: 6rpx;
}

/* 详情页进度条：健康绿 */
.progress-wrap {
  height: 18rpx;
  background-color: #efeff4;
  border-radius: 9rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background-image: linear-gradient(90deg, #66cdaa 0%, #4cd964 100%);
  border-radius: 9rpx;
  transition: width 0.3s ease;
}

/* 状态标签 */
.status-tip {
  display: inline-block;
  font-size: 24rpx;
  border-radius: 12rpx;
  padding: 6rpx 24rpx;
  margin-top: 20rpx;
  font-weight: 600;
}

.status-tip.done {
  color: #2e9e5b;
  background-color: #e6f9ee;
}

.status-tip.going {
  color: #ff9f1c;
  background-color: #fff3d6;
}

.status-tip.todo {
  color: #999999;
  background-color: #f5f5f7;
}

/* 记录明细 */
.record-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f5f5f7;
}

.record-row:last-child {
  border-bottom: none;
}

.record-time {
  width: 120rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #333333;
}

.record-info {
  flex: 1;
  display: flex;
  align-items: center;
}

.record-ml {
  font-size: 28rpx;
  color: #333333;
  margin-right: 16rpx;
}

.record-type {
  font-size: 24rpx;
  color: #4d9eff;
  background-color: #eef5ff;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  margin-right: 12rpx;
  font-weight: 600;
}

.record-remark {
  font-size: 24rpx;
  color: #999999;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-del {
  font-size: 26rpx;
  color: #ff6b6b;
  padding: 8rpx 16rpx;
}

.empty {
  text-align: center;
  color: #999999;
  font-size: 26rpx;
  padding: 40rpx 0;
}

.back-btn {
  font-size: 28rpx;
  padding: 16rpx 0;
}
