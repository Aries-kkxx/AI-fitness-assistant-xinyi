/* pages/water/water.wxss - 饮水页（卡通猫咪健身风格 · 新参考图 1:1 还原） */

.page {
  min-height: 100vh;
  padding: var(--space-xl);
  padding-bottom: calc(var(--space-3xl) + env(safe-area-inset-bottom));
}

.sky-bg {
  background: linear-gradient(180deg, #E8F7FF 0%, #F7F8FA 30%, #F7F8FA 100%);
}

.page-header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-xl);
}

.page-title {
  font-size: var(--fs-page-title);
  font-weight: 800;
  color: #222222;
}

.cloud-deco {
  position: absolute;
  left: 0;
  top: -20rpx;
  width: 80rpx;
  height: 80rpx;
  opacity: 0.8;
}

/* ===== 卡片通用 ===== */
.card {
  background-color: #FFFFFF;
  border-radius: var(--cat-radius-lg);
  padding: var(--space-xl);
  margin-bottom: var(--space-xl);
  box-shadow: var(--cat-shadow-md);
}

.card-title {
  font-size: var(--fs-card-title);
  font-weight: 700;
  color: #222222;
}

/* ===== 今日饮水卡片 ===== */
.water-card {
  display: flex;
  flex-direction: column;
}

.water-head {
  margin-bottom: var(--space-md);
}

.water-main {
  margin-bottom: var(--space-xl);
}

.water-big {
  display: flex;
  align-items: baseline;
  margin-bottom: var(--space-sm);
}

.water-big-num {
  font-size: 72rpx;
  font-weight: 800;
  color: #222222;
  line-height: 1;
}

.water-big-sep {
  font-size: 40rpx;
  color: #999999;
  margin: 0 var(--space-xs);
}

.water-big-target {
  font-size: 36rpx;
  color: #999999;
  font-weight: 600;
}

.water-cups {
  font-size: var(--fs-body);
  color: #666666;
  font-weight: 600;
  margin-bottom: var(--space-md);
}

.water-progress-row {
  display: flex;
  align-items: center;
}

.progress-wrap {
  flex: 1;
  height: 18rpx;
  background-color: #EEEEEE;
  border-radius: var(--cat-radius-pill);
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: linear-gradient(90deg, #66CDAA 0%, #4CD964 100%);
  border-radius: var(--cat-radius-pill);
}

.water-percent {
  font-size: var(--fs-body);
  font-weight: 700;
  color: #222222;
  margin-left: var(--space-md);
}

.water-actions {
  display: flex;
  gap: var(--space-md);
}

.drink-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-btn);
  font-weight: 700;
  color: #FFFFFF;
  background: linear-gradient(135deg, #66CDAA 0%, #4CD964 100%);
  border-radius: var(--cat-radius-pill);
  box-shadow: 0 8rpx 20rpx rgba(76, 217, 100, 0.28);
}

.add-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-btn);
  font-weight: 700;
  color: #FFFFFF;
  background: linear-gradient(135deg, #4D9EFF 0%, #2B7BBD 100%);
  border-radius: var(--cat-radius-pill);
  box-shadow: 0 8rpx 20rpx rgba(77, 158, 255, 0.28);
}

/* ===== 饮水记录列表 ===== */
.list-card {
  padding-bottom: var(--space-lg);
}

.record-row {
  display: flex;
  align-items: center;
  padding: var(--space-md) 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.record-time {
  width: 120rpx;
  font-size: var(--fs-body);
  color: #222222;
  font-weight: 600;
}

.record-ml {
  width: 140rpx;
  font-size: var(--fs-body);
  color: #222222;
  font-weight: 700;
}

.record-type {
  flex: 1;
  font-size: var(--fs-caption);
  color: #888888;
  background-color: #F5F8FF;
  border-radius: var(--cat-radius-sm);
  padding: 4rpx 16rpx;
  text-align: center;
  margin-right: var(--space-md);
}

.record-del {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-2xl) 0;
}

.empty-text {
  margin-top: var(--space-md);
  font-size: var(--fs-body);
  color: #888888;
}

.safe-bottom {
  margin-bottom: calc(var(--space-3xl) + env(safe-area-inset-bottom));
}
