/* pages/water/water.wxss - 饮水主页样式 */

.page {
  padding: 30rpx;
}

/* 统计卡片 */
.stats-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.stats-item {
  text-align: center;
  flex: 1;
}

.stats-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
}

.stats-num.green {
  color: #07c160;
}

.stats-unit {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-top: 4rpx;
}

.stats-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
}

.stats-remain {
  font-size: 26rpx;
  color: #999999;
}

.stats-link {
  font-size: 26rpx;
  color: #07c160;
}

/* 操作按钮行 */
.action-row {
  display: flex;
  margin-bottom: 24rpx;
}

.drink-btn {
  flex: 1;
  margin-right: 20rpx;
}

.add-btn {
  flex: 1;
}

/* 记录列表 */
.record-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.record-row:last-child {
  border-bottom: none;
}

.record-time {
  width: 120rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.record-info {
  flex: 1;
  display: flex;
  align-items: center;
}

.record-ml {
  font-size: 28rpx;
  color: #333333;
  margin-right: 16rpx;
}

.record-type {
  font-size: 24rpx;
  color: #07c160;
  background-color: #f0faf5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}

.record-remark {
  font-size: 24rpx;
  color: #999999;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-del {
  font-size: 26rpx;
  color: #e64340;
  padding: 8rpx 16rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  color: #999999;
  font-size: 26rpx;
  padding: 40rpx 0;
}
